<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= titulo %> | AutoRentCar
    </title>


    <link
        rel="stylesheet"
        href="/css/admin.css"
    >


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>


<body>


<div class="admin-shell">


    <%- include("../partials/sidebar") %>


    <div class="admin-content-wrapper">


        <%- include("../partials/header") %>


        <main class="admin-main-content">


            <div class="form-page-top">

                <a
                    href="/admin/agencias/<%= agencia.id %>/sucursales"
                    class="back-link"
                >

                    <i class="fa-solid fa-arrow-left"></i>

                    Volver a sucursales

                </a>

            </div>



            <section class="dashboard-panel">


                <div class="panel-header">


                    <div>

                        <span class="panel-eyebrow">
                            Editar sucursal
                        </span>


                        <h3>
                            <%= sucursalEditar.nombre %>
                        </h3>


                        <p>
                            Modifica los datos de esta ubicación
                            perteneciente a <%= agencia.nombre %>.
                        </p>

                    </div>


                </div>



                <% if (error) { %>

                    <div class="admin-alert admin-alert-error">

                        <i class="fa-solid fa-circle-exclamation"></i>


                        <div>

                            <strong>
                                No fue posible actualizar la sucursal
                            </strong>


                            <span>
                                <%= error %>
                            </span>

                        </div>

                    </div>

                <% } %>



                <% if (suscripcion) { %>

                    <div class="admin-alert admin-alert-info">

                        <i class="fa-solid fa-layer-group"></i>


                        <div>

                            <strong>
                                <%= suscripcion.plan_nombre %>
                            </strong>


                            <span>

                                Límite de sucursales activas:

                                <%= suscripcion.limite_sucursales === null
                                    ? "Ilimitadas"
                                    : suscripcion.limite_sucursales
                                %>

                            </span>

                        </div>

                    </div>

                <% } %>



                <div class="user-form-card">


                    <form
                        method="POST"
                        action="/admin/agencias/<%= agencia.id %>/sucursales/<%= sucursalEditar.id %>/editar"
                    >


                        <div class="user-form-grid">


                            <div class="user-form-group">

                                <label for="nombre">
                                    Nombre de la sucursal
                                </label>


                                <input
                                    type="text"
                                    id="nombre"
                                    name="nombre"
                                    maxlength="120"
                                    value="<%= sucursalEditar.nombre || '' %>"
                                    required
                                >

                            </div>



                            <div class="user-form-group">

                                <label for="correo">
                                    Correo electrónico
                                </label>


                                <input
                                    type="email"
                                    id="correo"
                                    name="correo"
                                    maxlength="150"
                                    value="<%= sucursalEditar.correo || '' %>"
                                >

                            </div>



                            <div class="user-form-group">

                                <label for="telefono">
                                    Teléfono
                                </label>


                                <input
                                    type="text"
                                    id="telefono"
                                    name="telefono"
                                    maxlength="30"
                                    value="<%= sucursalEditar.telefono || '' %>"
                                >

                            </div>



                            <div class="user-form-group">

                                <label for="whatsapp">
                                    WhatsApp
                                </label>


                                <input
                                    type="text"
                                    id="whatsapp"
                                    name="whatsapp"
                                    maxlength="30"
                                    value="<%= sucursalEditar.whatsapp || '' %>"
                                >

                            </div>



                            <div class="user-form-group user-form-full">

                                <label for="direccion">
                                    Dirección
                                </label>


                                <input
                                    type="text"
                                    id="direccion"
                                    name="direccion"
                                    maxlength="255"
                                    value="<%= sucursalEditar.direccion || '' %>"
                                >

                            </div>



                            <div class="user-form-group">

                                <label for="ciudad">
                                    Ciudad
                                </label>


                                <input
                                    type="text"
                                    id="ciudad"
                                    name="ciudad"
                                    maxlength="100"
                                    value="<%= sucursalEditar.ciudad || '' %>"
                                >

                            </div>



                            <div class="user-form-group">

                                <label for="provincia">
                                    Provincia
                                </label>


                                <input
                                    type="text"
                                    id="provincia"
                                    name="provincia"
                                    maxlength="100"
                                    value="<%= sucursalEditar.provincia || '' %>"
                                >

                            </div>



                            <div class="user-form-group">

                                <label for="pais">
                                    País
                                </label>


                                <input
                                    type="text"
                                    id="pais"
                                    name="pais"
                                    maxlength="100"
                                    value="<%= sucursalEditar.pais || 'República Dominicana' %>"
                                    required
                                >

                            </div>



                            <div class="user-form-group">

                                <label for="estado">
                                    Estado
                                </label>


                                <select
                                    id="estado"
                                    name="estado"
                                >

                                    <option
                                        value="activa"
                                        <%= sucursalEditar.estado === "activa"
                                            ? "selected"
                                            : ""
                                        %>
                                    >
                                        Activa
                                    </option>


                                    <option
                                        value="inactiva"
                                        <%= sucursalEditar.estado === "inactiva"
                                            ? "selected"
                                            : ""
                                        %>
                                    >
                                        Inactiva
                                    </option>

                                </select>

                            </div>



                            <div class="user-form-group">

                                <label for="es_principal">
                                    Tipo de sucursal
                                </label>


                                <select
                                    id="es_principal"
                                    name="es_principal"
                                >

                                    <option
                                        value="0"
                                        <%= Number(sucursalEditar.es_principal) !== 1
                                            ? "selected"
                                            : ""
                                        %>
                                    >
                                        Secundaria
                                    </option>


                                    <option
                                        value="1"
                                        <%= Number(sucursalEditar.es_principal) === 1
                                            ? "selected"
                                            : ""
                                        %>
                                    >
                                        Principal
                                    </option>

                                </select>

                            </div>


                        </div>



                        <% if (
                            Number(
                                sucursalEditar.es_principal
                            ) === 1
                        ) { %>

                            <div class="admin-alert admin-alert-info">

                                <i class="fa-solid fa-star"></i>


                                <div>

                                    <strong>
                                        Sucursal principal
                                    </strong>


                                    <span>
                                        Para elegir otra sucursal como
                                        principal, edita esa sucursal y
                                        selecciona Principal.
                                    </span>

                                </div>

                            </div>

                        <% } %>



                        <div class="user-form-actions">


                            <a
                                href="/admin/agencias/<%= agencia.id %>/sucursales"
                                class="user-btn-cancel"
                            >
                                Cancelar
                            </a>


                            <button
                                type="submit"
                                class="user-btn-create"
                            >

                                <i class="fa-solid fa-floppy-disk"></i>

                                Guardar cambios

                            </button>


                        </div>


                    </form>


                </div>


            </section>



            <footer class="admin-footer">

                <span>
                    AutoRentCar Platform
                </span>


                <span>
                    © <%= new Date().getFullYear() %>
                </span>

            </footer>


        </main>


    </div>


</div>


<script src="/js/admin.js"></script>


</body>

</html>