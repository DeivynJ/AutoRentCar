<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Configuración de la cuenta SuperAdministrador de AutoRentCar."
    >

    <title>
        <%= titulo %> | AutoRentCar
    </title>


    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <link
        rel="stylesheet"
        href="/css/admin.css"
    >

</head>


<body>


<div class="admin-shell">


    <%- include("../partials/sidebar") %>


    <div class="admin-content-wrapper">


        <%- include("../partials/header") %>


        <main class="admin-main-content">


            <!-- =============================================
                 CABECERA
            ============================================== -->

            <section
                class="module-hero"
                data-animate="fade-up"
            >


                <div>


                    <div class="module-hero-badge">

                        <i class="fa-solid fa-gear"></i>

                        <span>
                            Cuenta administrativa
                        </span>

                    </div>


                    <h2>
                        Configuración
                    </h2>


                    <p>

                        Administra la información de tu cuenta
                        SuperAdministrador y protege el acceso
                        a la plataforma.

                    </p>


                </div>


            </section>


            <!-- =============================================
                 MENSAJE DE ÉXITO
            ============================================== -->

            <% if (mensajeExito) { %>

                <div class="admin-alert admin-alert-success">

                    <i class="fa-solid fa-circle-check"></i>


                    <div>

                        <strong>
                            Operación completada
                        </strong>

                        <span>
                            <%= mensajeExito %>
                        </span>

                    </div>

                </div>

            <% } %>


            <!-- =============================================
                 PERFIL
            ============================================== -->

            <section
                class="dashboard-panel"
                data-animate="fade-up"
            >


                <div class="panel-header">


                    <div>

                        <span class="panel-eyebrow">
                            Mi cuenta
                        </span>

                        <h3>
                            Información del perfil
                        </h3>

                        <p>

                            Estos datos identifican tu cuenta
                            administrativa dentro de AutoRentCar.

                        </p>

                    </div>


                </div>


                <% if (errorPerfil) { %>

                    <div class="admin-alert admin-alert-danger">

                        <i class="fa-solid fa-circle-exclamation"></i>


                        <div>

                            <strong>
                                No fue posible actualizar el perfil
                            </strong>

                            <span>
                                <%= errorPerfil %>
                            </span>

                        </div>

                    </div>

                <% } %>


                <div class="user-form-card">


                    <form
    method="POST"
    action="/admin/configuracion/perfil"
    enctype="multipart/form-data"
>

<!-- =============================================
     FOTO DE PERFIL
============================================== -->

<div
    style="
        display:flex;
        align-items:center;
        gap:20px;
        margin-bottom:24px;
        padding-bottom:24px;
        border-bottom:1px solid #e7ebf0;
    "
>

    <div
        class="agency-profile-logo"
        id="foto-perfil-preview"
        style="
            width:100px;
            height:100px;
            flex-shrink:0;
            border:1px solid #e5e9ef;
        "
    >

        <% if (perfil.foto_perfil) { %>

            <img
                id="foto-perfil-preview-img"
                src="<%= perfil.foto_perfil %>"
                alt="Foto de perfil"
                style="object-fit:cover; padding:0;"
            >

            <span
                id="foto-perfil-preview-inicial"
                style="display:none;"
            >
                <%= String(perfil.nombre || "U")
                    .charAt(0)
                    .toUpperCase()
                %>
            </span>

        <% } else { %>

            <img
                id="foto-perfil-preview-img"
                src=""
                alt="Foto de perfil"
                style="
                    display:none;
                    object-fit:cover;
                    padding:0;
                "
            >

            <span id="foto-perfil-preview-inicial">

                <%= String(perfil.nombre || "U")
                    .charAt(0)
                    .toUpperCase()
                %>

            </span>

        <% } %>

    </div>


    <div style="flex:1; min-width:0;">

        <div class="user-form-group">

            <label for="foto_perfil">
                Foto de perfil o logo
            </label>

            <input
                type="file"
                id="foto_perfil"
                name="foto_perfil"
                accept="image/png,image/jpeg,image/webp"
            >

        </div>


        <p
            style="
                margin:8px 0 0;
                color:#748096;
                font-size:.72rem;
                line-height:1.6;
            "
        >
            Puedes usar una fotografía personal o el logo de la plataforma.
            Formatos permitidos: JPG, PNG y WebP. Máximo 3 MB.
        </p>


        <% if (perfil.foto_perfil) { %>

            <p
                style="
                    margin:6px 0 0;
                    color:#748096;
                    font-size:.70rem;
                "
            >
                Si no seleccionas otra imagen, se conservará la actual.
            </p>

        <% } %>

    </div>

</div>

                        <div class="user-form-grid">


                            <!-- NOMBRE -->

                            <div class="user-form-group">

                                <label for="nombre">
                                    Nombre
                                </label>

                                <input
                                    type="text"
                                    id="nombre"
                                    name="nombre"
                                    maxlength="120"
                                    value="<%= perfil.nombre || '' %>"
                                    required
                                >

                            </div>


                            <!-- APELLIDO -->

                            <div class="user-form-group">

                                <label for="apellido">
                                    Apellido
                                </label>

                                <input
                                    type="text"
                                    id="apellido"
                                    name="apellido"
                                    maxlength="120"
                                    value="<%= perfil.apellido || '' %>"
                                >

                            </div>


                            <!-- CORREO -->

                            <div class="user-form-group">

                                <label for="correo">
                                    Correo electrónico
                                </label>

                                <input
                                    type="email"
                                    id="correo"
                                    name="correo"
                                    maxlength="150"
                                    value="<%= perfil.correo || '' %>"
                                    autocomplete="email"
                                    required
                                >

                            </div>


                            <!-- TELÉFONO -->

                            <div class="user-form-group">

                                <label for="telefono">
                                    Teléfono
                                </label>

                                <input
                                    type="text"
                                    id="telefono"
                                    name="telefono"
                                    maxlength="30"
                                    value="<%= perfil.telefono || '' %>"
                                    autocomplete="tel"
                                >

                            </div>


                            <!-- ROL -->

                            <div class="user-form-group">

                                <label>
                                    Rol
                                </label>

                                <input
                                    type="text"
                                    value="<%= perfil.rol_nombre || 'SuperAdministrador' %>"
                                    disabled
                                >

                            </div>


                            <!-- ESTADO -->

                            <div class="user-form-group">

                                <label>
                                    Estado de la cuenta
                                </label>

                                <input
                                    type="text"
                                    value="<%= perfil.estado === 'activo' ? 'Activo' : (perfil.estado || 'Activo') %>"
                                    disabled
                                >

                            </div>


                        </div>


                        <div class="user-form-actions">


                            <a
                                href="/admin"
                                class="form-cancel"
                            >
                                Cancelar
                            </a>


                            <button
                                type="submit"
                                class="user-btn-create"
                            >

                                <i class="fa-solid fa-floppy-disk"></i>

                                Guardar perfil

                            </button>


                        </div>


                    </form>


                </div>


            </section>


            <!-- =============================================
                 SEGURIDAD
            ============================================== -->

            <section
                class="dashboard-panel"
                data-animate="fade-up"
            >


                <div class="panel-header">


                    <div>

                        <span class="panel-eyebrow">
                            Seguridad
                        </span>

                        <h3>
                            Cambiar contraseña
                        </h3>

                        <p>

                            Para cambiar tu contraseña debes
                            confirmar primero la contraseña actual.

                        </p>

                    </div>


                </div>


                <% if (errorPassword) { %>

                    <div class="admin-alert admin-alert-danger">

                        <i class="fa-solid fa-triangle-exclamation"></i>


                        <div>

                            <strong>
                                No fue posible cambiar la contraseña
                            </strong>

                            <span>
                                <%= errorPassword %>
                            </span>

                        </div>

                    </div>

                <% } %>


                <div class="user-form-card">


                    <form
                        method="POST"
                        action="/admin/configuracion/password"
                    >


                        <div class="user-form-grid">


                            <!-- CONTRASEÑA ACTUAL -->

                            <div class="user-form-group">

                                <label for="password_actual">
                                    Contraseña actual
                                </label>

                                <input
                                    type="password"
                                    id="password_actual"
                                    name="password_actual"
                                    autocomplete="current-password"
                                    required
                                >

                            </div>


                            <!-- NUEVA CONTRASEÑA -->

                            <div class="user-form-group">

                                <label for="password_nueva">
                                    Nueva contraseña
                                </label>

                                <input
                                    type="password"
                                    id="password_nueva"
                                    name="password_nueva"
                                    minlength="8"
                                    autocomplete="new-password"
                                    required
                                >

                            </div>


                            <!-- CONFIRMACIÓN -->

                            <div class="user-form-group">

                                <label for="password_confirmacion">
                                    Confirmar nueva contraseña
                                </label>

                                <input
                                    type="password"
                                    id="password_confirmacion"
                                    name="password_confirmacion"
                                    minlength="8"
                                    autocomplete="new-password"
                                    required
                                >

                            </div>


                        </div>


                        <div class="user-form-actions">


                            <button
                                type="reset"
                                class="form-cancel"
                            >
                                Limpiar
                            </button>


                            <button
                                type="submit"
                                class="user-btn-create"
                                onclick="return confirm('¿Deseas cambiar la contraseña de tu cuenta SuperAdministrador?');"
                            >

                                <i class="fa-solid fa-key"></i>

                                Cambiar contraseña

                            </button>


                        </div>


                    </form>


                </div>


            </section>


            <footer class="admin-footer">

                <span>
                    AutoRentCar Platform
                </span>

                <span>
                    © <%= new Date().getFullYear() %>
                </span>

            </footer>


        </main>


    </div>


</div>


<script src="/js/admin.js"></script>

<script>

const inputFotoPerfil =
    document.getElementById(
        "foto_perfil"
    );


const imagenPreview =
    document.getElementById(
        "foto-perfil-preview-img"
    );


const inicialPreview =
    document.getElementById(
        "foto-perfil-preview-inicial"
    );


inputFotoPerfil
    ?.addEventListener(
        "change",
        event =>
        {

            const archivo =
                event.target.files?.[0];


            if (!archivo) {

                return;

            }


            const tiposPermitidos =
                [
                    "image/png",
                    "image/jpeg",
                    "image/webp"
                ];


            if (
                !tiposPermitidos.includes(
                    archivo.type
                )
            ) {

                alert(
                    "Selecciona una imagen JPG, PNG o WebP."
                );


                event.target.value =
                    "";


                return;

            }


            if (
                archivo.size >
                3 * 1024 * 1024
            ) {

                alert(
                    "La imagen no puede superar los 3 MB."
                );


                event.target.value =
                    "";


                return;

            }


            const lector =
                new FileReader();


            lector.onload =
                resultado =>
                {

                    if (!imagenPreview) {

                        return;

                    }


                    imagenPreview.src =
                        resultado.target.result;


                    imagenPreview.style.display =
                        "block";


                    if (
                        inicialPreview
                    ) {

                        inicialPreview.style.display =
                            "none";

                    }

                };


            lector.readAsDataURL(
                archivo
            );

        }
    );

</script>


</body>

</html>