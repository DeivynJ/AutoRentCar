<header class="admin-topbar">

    <!-- =============================================
         ZONA IZQUIERDA
    ============================================== -->

    <div class="topbar-left">

        <button
            type="button"
            class="topbar-menu-mobile"
            id="topbar-menu-mobile"
            aria-label="Abrir menú"
        >
            <i class="fa-solid fa-bars"></i>
        </button>

        <div class="topbar-title">

            <span class="topbar-eyebrow">
                <%= subtituloPagina || "Panel administrativo" %>
            </span>

            <h1>
                <%= titulo %>
            </h1>

        </div>

    </div>


    <!-- =============================================
         ZONA DERECHA
    ============================================== -->

    <div class="topbar-right">

       <!-- =============================================
     ACCIONES RÁPIDAS
============================================== -->

<div
    class="topbar-quick-action"
    id="topbar-quick-action"
>

    <button
        type="button"
        class="topbar-action-button"
        id="topbar-quick-action-button"
        title="Acciones rápidas"
        aria-label="Abrir acciones rápidas"
        aria-expanded="false"
        aria-controls="topbar-quick-action-menu"
    >

        <i class="fa-solid fa-plus"></i>

        <span>
            Acción rápida
        </span>

    </button>


    <div
        class="topbar-quick-action-menu"
        id="topbar-quick-action-menu"
        aria-hidden="true"
    >

        <div class="topbar-quick-action-header">

            <span>
                Acciones rápidas
            </span>

            <small>
                SuperAdministrador
            </small>

        </div>


        <div class="topbar-quick-action-divider"></div>


        <a
            href="/admin/agencias/nueva"
            class="topbar-quick-action-link"
        >

            <span class="topbar-quick-action-icon">

                <i class="fa-solid fa-building-circle-check"></i>

            </span>


            <span>

                <strong>
                    Nueva agencia
                </strong>

                <small>
                    Registrar un nuevo Rent Car
                </small>

            </span>

        </a>


        <a
            href="/admin/planes/nuevo"
            class="topbar-quick-action-link"
        >

            <span class="topbar-quick-action-icon">

                <i class="fa-solid fa-layer-group"></i>

            </span>


            <span>

                <strong>
                    Nuevo plan
                </strong>

                <small>
                    Crear un plan comercial
                </small>

            </span>

        </a>


        <div class="topbar-quick-action-divider"></div>


        <a
            href="/admin/agencias"
            class="topbar-quick-action-link"
        >

            <span class="topbar-quick-action-icon">

                <i class="fa-solid fa-building"></i>

            </span>


            <span>

                <strong>
                    Gestionar agencias
                </strong>

                <small>
                    Ver agencias registradas
                </small>

            </span>

        </a>


        <a
            href="/admin/suscripciones"
            class="topbar-quick-action-link"
        >

            <span class="topbar-quick-action-icon">

                <i class="fa-solid fa-calendar-check"></i>

            </span>


            <span>

                <strong>
                    Suscripciones
                </strong>

                <small>
                    Administrar planes contratados
                </small>

            </span>

        </a>

    </div>

</div>

        <!-- MODO CLARO / OSCURO -->
         
<button

    type="button"
    class="topbar-icon-button admin-theme-button"
    id="admin-theme-toggle"
    aria-label="Activar modo oscuro"
    title="Modo oscuro"
    aria-pressed="false"
>
    <i class="fa-regular fa-moon"></i>

</button>


        <!-- =============================================
     NOTIFICACIONES
============================================== -->

<%
    const listaNotificacionesAdmin =
        Array.isArray(notificacionesAdmin)
            ? notificacionesAdmin
            : [];

    const totalNotificacionesAdminNoLeidas =
        Number(notificacionesAdminNoLeidas || 0);
%>


<div
    class="topbar-notifications"
    id="topbar-notifications"
>

    <button
        type="button"
        class="topbar-icon-button"
        id="topbar-notifications-button"
        aria-label="Notificaciones"
        title="Notificaciones"
        aria-expanded="false"
        aria-controls="topbar-notifications-menu"
    >

        <i class="fa-regular fa-bell"></i>


        <% if (totalNotificacionesAdminNoLeidas > 0) { %>

            <span
                class="topbar-notification-count"
                aria-label="<%= totalNotificacionesAdminNoLeidas %> notificaciones no leídas"
            >

                <%= totalNotificacionesAdminNoLeidas > 99
                    ? "99+"
                    : totalNotificacionesAdminNoLeidas
                %>

            </span>

        <% } %>

    </button>


    <div
        class="topbar-notifications-menu"
        id="topbar-notifications-menu"
        aria-hidden="true"
    >

        <!-- CABECERA -->

        <div class="topbar-notifications-header">

            <div>

                <strong>
                    Notificaciones
                </strong>

                <span>

                    <% if (totalNotificacionesAdminNoLeidas > 0) { %>

                        <%= totalNotificacionesAdminNoLeidas %>
                        sin leer

                    <% } else { %>

                        Todo al día

                    <% } %>

                </span>

            </div>


            <span class="topbar-notifications-header-icon">

                <i class="fa-regular fa-bell"></i>

            </span>

        </div>


        <div class="topbar-notifications-divider"></div>


        <!-- LISTADO -->

        <% if (listaNotificacionesAdmin.length) { %>

            <div class="topbar-notifications-list">


                <% listaNotificacionesAdmin.forEach((notificacion) => { %>

                    <form
                        method="POST"
                        action="/admin/notificaciones/<%= notificacion.id %>/abrir"
                        class="topbar-notification-form"
                    >

                        <button
                            type="submit"
                            class="topbar-notification-item <%= notificacion.leida ? '' : 'is-unread' %>"
                        >


                            <!-- ICONO -->

                            <span
                                class="topbar-notification-icon nivel-<%= notificacion.nivel || 'info' %>"
                            >

                                <% if (notificacion.nivel === "exito") { %>

                                    <i class="fa-solid fa-circle-check"></i>

                                <% } else if (notificacion.nivel === "advertencia") { %>

                                    <i class="fa-solid fa-triangle-exclamation"></i>

                                <% } else if (notificacion.nivel === "critica") { %>

                                    <i class="fa-solid fa-circle-exclamation"></i>

                                <% } else { %>

                                    <i class="fa-solid fa-circle-info"></i>

                                <% } %>

                            </span>


                            <!-- CONTENIDO -->

                            <span class="topbar-notification-content">

                                <span class="topbar-notification-title-row">

                                    <strong>
                                        <%= notificacion.titulo %>
                                    </strong>


                                    <% if (!notificacion.leida) { %>

                                        <span
                                            class="topbar-notification-unread-dot"
                                            title="No leída"
                                        ></span>

                                    <% } %>

                                </span>


                                <span class="topbar-notification-message">

                                    <%= notificacion.mensaje %>

                                </span>


                                <span class="topbar-notification-meta">

                                    <i class="fa-regular fa-clock"></i>

                                    <%= formatoFechaHora(
                                        notificacion.fecha_creacion
                                    ) %>

                                </span>

                            </span>


                            <span class="topbar-notification-arrow">

                                <i class="fa-solid fa-chevron-right"></i>

                            </span>


                        </button>

                    </form>

                <% }); %>


            </div>

        <% } else { %>


            <div class="topbar-notifications-empty">

                <span>

                    <i class="fa-regular fa-bell-slash"></i>

                </span>

                <strong>
                    No hay notificaciones
                </strong>

                <p>
                    Cuando ocurra algo importante en la plataforma aparecerá aquí.
                </p>

            </div>


        <% } %>


    </div>

</div>


        <!-- USUARIO -->

        <div class="topbar-user">

            <button
                type="button"
                class="topbar-user-button"
                id="topbar-user-button"
                aria-expanded="false"
            >

               <span
    class="topbar-user-avatar"
    style="overflow:hidden;"
>

    <% if (usuario.foto_perfil) { %>

        <img
            src="<%= usuario.foto_perfil %>"
            alt="Foto de perfil"
            style="
                width:100%;
                height:100%;
                display:block;
                object-fit:cover;
            "
        >

    <% } else { %>

        <%= usuario.nombre
            .charAt(0)
            .toUpperCase() %>

    <% } %>

</span>

                <span class="topbar-user-info">

                    <strong>
                        <%= usuario.nombre %>
                        <%= usuario.apellido || "" %>
                    </strong>

                    <small>
                        <%= usuario.rolNombre %>
                    </small>

                </span>

                <i class="fa-solid fa-chevron-down topbar-user-arrow"></i>

            </button>


            <!-- MENÚ DESPLEGABLE -->

            <div
                class="topbar-user-menu"
                id="topbar-user-menu"
            >

                <div class="topbar-user-menu-header">

                    <span
    class="topbar-user-avatar grande"
    style="overflow:hidden;"
>

    <% if (usuario.foto_perfil) { %>

        <img
            src="<%= usuario.foto_perfil %>"
            alt="Foto de perfil"
            style="
                width:100%;
                height:100%;
                display:block;
                object-fit:cover;
            "
        >

    <% } else { %>

        <%= usuario.nombre
            .charAt(0)
            .toUpperCase() %>

    <% } %>

</span>

                    <div>

                        <strong>
                            <%= usuario.nombre %>
                            <%= usuario.apellido || "" %>
                        </strong>

                        <span>
                            <%= usuario.correo %>
                        </span>

                    </div>

                </div>

                <div class="topbar-user-menu-divider"></div>

                <a
                    href="/admin/configuracion"
                    class="topbar-user-menu-link"
                >

                    <i class="fa-solid fa-gear"></i>

                    <span>
                        Configuración
                    </span>

                </a>

                <div class="topbar-user-menu-divider"></div>

                <form
                    action="/logout"
                    method="POST"
                >

                    <button
                        type="submit"
                        class="topbar-user-menu-link danger"
                    >

                        <i class="fa-solid fa-arrow-right-from-bracket"></i>

                        <span>
                            Cerrar sesión
                        </span>

                    </button>

                </form>

            </div>

        </div>

    </div>

</header>