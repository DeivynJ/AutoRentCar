<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= titulo %> | AutoRentCar
    </title>


    <link
        rel="stylesheet"
        href="/css/admin.css"
    >


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>


<body>


<div class="admin-shell">


    <%- include("../partials/sidebar") %>


    <div class="admin-content-wrapper">


        <%- include("../partials/header") %>


        <main class="admin-main-content">


            <!-- =====================================
                 VOLVER
            ====================================== -->

            <div class="form-page-top">

                <a
                    href="/admin/agencias/<%= agencia.id %>"
                    class="back-link"
                >

                    <i class="fa-solid fa-arrow-left"></i>

                    Volver al detalle

                </a>

            </div>



            <!-- =====================================
                 AGENCIA
            ====================================== -->

            <section class="agency-profile-hero">


                <div class="agency-profile-main">


                    <div class="agency-profile-logo">


                        <% if (agencia.logo) { %>

                            <img
                                src="<%= agencia.logo %>"
                                alt="<%= agencia.nombre %>"
                            >

                        <% } else { %>

                            <span>

                                <%= agencia.nombre
                                    .charAt(0)
                                    .toUpperCase()
                                %>

                            </span>

                        <% } %>


                    </div>


                    <div class="agency-profile-info">


                        <span class="profile-label">
                            Gestión de vehículos
                        </span>


                        <h1>
                            <%= agencia.nombre %>
                        </h1>


                        <p>
                            Administra los modelos y las unidades
                            físicas de la flota.
                        </p>


                    </div>


                </div>


                <div class="agency-profile-status">


                    <span
                        class="status-badge status-<%= agencia.estado %>"
                    >

                        <span class="status-dot"></span>

                        <%= agencia.estado %>

                    </span>


                    <span class="plan-badge">

                        <i class="fa-solid fa-layer-group"></i>

                        <%= suscripcion
                            ? suscripcion.plan_nombre
                            : "Sin plan"
                        %>

                    </span>


                </div>


            </section>

            <% if (mensajeExito) { %>

    <div class="admin-alert admin-alert-success">

        <i class="fa-solid fa-circle-check"></i>


        <div>

            <strong>
                Operación completada
            </strong>


            <span>
                <%= mensajeExito %>
            </span>

        </div>

    </div>

<% } %>



            <!-- =====================================
                 ESTADÍSTICAS
            ====================================== -->

            <section class="dashboard-stats agency-detail-stats">


                <article class="stat-card">

                    <div class="stat-icon stat-icon-blue">

                        <i class="fa-solid fa-car-side"></i>

                    </div>


                    <span class="stat-title">
                        Modelos
                    </span>


                    <strong class="stat-value">
                        <%= resumen.modelos %>
                    </strong>

                </article>



                <article class="stat-card">

                    <div class="stat-icon stat-icon-purple">

                        <i class="fa-solid fa-cars"></i>

                    </div>


                    <span class="stat-title">
                        Unidades
                    </span>


                    <strong class="stat-value">
                        <%= resumen.unidades %>
                    </strong>

                </article>



                <article class="stat-card">

                    <div class="stat-icon stat-icon-green">

                        <i class="fa-solid fa-circle-check"></i>

                    </div>


                    <span class="stat-title">
                        Disponibles
                    </span>


                    <strong class="stat-value">
                        <%= resumen.disponibles %>
                    </strong>

                </article>



                <article class="stat-card">

                    <div class="stat-icon stat-icon-orange">

                        <i class="fa-solid fa-layer-group"></i>

                    </div>


                    <span class="stat-title">
                        Límite del plan
                    </span>


                    <strong class="stat-value">

                        <% if (!suscripcion) { %>

                            —

                        <% } else if (
                            suscripcion.limite_vehiculos === null
                        ) { %>

                            ∞

                        <% } else { %>

                            <%= suscripcion.limite_vehiculos %>

                        <% } %>

                    </strong>

                </article>


            </section>

<!-- =====================================
     TABLA DE MODELOS
====================================== -->

<section
    class="dashboard-panel vehicle-models-panel"
    data-animate="fade-up"
>


    <!-- =================================
         CABECERA
    ================================== -->

    <div class="panel-header">


        <div>

            <span class="panel-eyebrow">
                Flota
            </span>


            <h3>
                Modelos registrados
            </h3>


            <p>
                Catálogo de vehículos pertenecientes
                a <%= agencia.nombre %>.
            </p>

        </div>


        <a
            href="/admin/agencias/<%= agencia.id %>/vehiculos/modelos/nuevo"
            class="user-btn-create"
        >

            <i class="fa-solid fa-plus"></i>

            Nuevo modelo

        </a>


    </div>



    <!-- =================================
         TABLA
    ================================== -->

    <div class="table-container vehicle-models-table-container">


        <table class="admin-table vehicle-models-table">


            <thead>

                <tr>

                    <th>
                        Vehículo
                    </th>

                    <th>
                        Categoría
                    </th>

                    <th>
                        Precio diario
                    </th>

                    <th>
                        Flota
                    </th>

                    <th>
                        Estado
                    </th>

                    <th class="vehicle-actions-heading">
                        Acción
                    </th>

                </tr>

            </thead>



            <tbody>


            <!-- =================================
                 SIN MODELOS
            ================================== -->

            <% if (modelos.length === 0) { %>


                <tr>


                    <td
                        colspan="6"
                        class="table-empty"
                    >


                        <div>


                            <i class="fa-solid fa-car-burst"></i>


                            <strong>
                                No hay vehículos registrados
                            </strong>


                            <span>
                                Esta agencia todavía no tiene
                                modelos de vehículos configurados.
                            </span>


                        </div>


                    </td>


                </tr>


            <% } %>




            <!-- =================================
                 MODELOS
            ================================== -->

            <% modelos.forEach((modelo) => { %>


                <tr>


                    <!-- =========================
                         VEHÍCULO
                    ========================== -->

                    <td>


                        <div class="vehicle-model-main">


                            <div class="vehicle-model-image">


                                <% if (modelo.imagen) { %>


                                    <img
                                        src="<%= modelo.imagen %>"
                                        alt="<%= modelo.marca %> <%= modelo.nombre %>"
                                    >


                                <% } else { %>


                                    <i class="fa-solid fa-car-side"></i>


                                <% } %>


                            </div>



                            <div class="vehicle-model-info">


                                <strong>
                                    <%= modelo.marca %>
                                    <%= modelo.nombre %>
                                </strong>


                                <% if (modelo.anio) { %>


                                    <span>
                                        Año <%= modelo.anio %>
                                    </span>


                                <% } %>


                            </div>


                        </div>


                    </td>




                    <!-- =========================
                         CATEGORÍA
                    ========================== -->

                    <td>


                        <div class="vehicle-table-data">


                            <strong>
                                Categoría
                            </strong>


                            <span>


                                <% if (
                                    modelo.categoria === "economico"
                                ) { %>


                                    Económico


                                <% } else if (
                                    modelo.categoria === "gama_media"
                                ) { %>


                                    Gama media


                                <% } else { %>


                                    Vehículo de lujo


                                <% } %>


                            </span>


                        </div>


                    </td>




                    <!-- =========================
                         PRECIO
                    ========================== -->

                    <td>


                        <div class="vehicle-table-data">


                            <strong>
                                Precio diario
                            </strong>


                            <span class="vehicle-price">

                                USD $<%= Number(
                                    modelo.precio_diario ||
                                    0
                                ).toFixed(2) %>

                            </span>


                        </div>


                    </td>




                    <!-- =========================
                         FLOTA
                    ========================== -->

                    <td>


                        <div class="vehicle-fleet-info">


                            <div>


                                <strong>
                                    <%= Number(
                                        modelo.total_unidades ||
                                        0
                                    ) %>
                                </strong>


                                <span>
                                    unidades
                                </span>


                            </div>



                            <div>


                                <strong>
                                    <%= Number(
                                        modelo.disponibles ||
                                        0
                                    ) %>
                                </strong>


                                <span>
                                    disponibles
                                </span>


                            </div>


                        </div>


                    </td>




                    <!-- =========================
                         ESTADO
                    ========================== -->

                    <td>


                        <% if (
                            modelo.estado === "activo"
                        ) { %>


                            <span class="status-badge status-activa">

                                <span class="status-dot"></span>

                                Activo

                            </span>


                        <% } else { %>


                            <span class="status-badge status-suspendida">

                                <span class="status-dot"></span>

                                Inactivo

                            </span>


                        <% } %>


                    </td>




                    <!-- =========================
                         ACCIONES
                    ========================== -->

                    <td>


                        <div class="vehicle-model-actions">


                            <a
                                href="/admin/agencias/<%= agencia.id %>/vehiculos/modelos/<%= modelo.id %>/editar"
                                class="table-action"
                                title="Editar modelo"
                                aria-label="Editar <%= modelo.marca %> <%= modelo.nombre %>"
                            >

                                <i class="fa-solid fa-pen-to-square"></i>

                            </a>



                            <a
                                href="/admin/agencias/<%= agencia.id %>/vehiculos/modelos/<%= modelo.id %>/unidades"
                                class="table-action"
                                title="Ver unidades"
                                aria-label="Ver unidades de <%= modelo.marca %> <%= modelo.nombre %>"
                            >

                                <i class="fa-solid fa-list"></i>

                            </a>



                            <% if (
                                modelo.estado === "activo"
                            ) { %>


                                <a
                                    href="/admin/agencias/<%= agencia.id %>/vehiculos/modelos/<%= modelo.id %>/unidades/nueva"
                                    class="table-action"
                                    title="Agregar unidad"
                                    aria-label="Agregar unidad a <%= modelo.marca %> <%= modelo.nombre %>"
                                >

                                    <i class="fa-solid fa-plus"></i>

                                </a>


                            <% } %>


                        </div>


                    </td>


                </tr>


            <% }); %>


            </tbody>


        </table>


    </div>


</section>

        

            <footer class="admin-footer">

                <span>
                    AutoRentCar Platform
                </span>


                <span>
                    © <%= new Date().getFullYear() %>
                </span>

            </footer>


        </main>


    </div>


</div>


<script src="/js/admin.js"></script>


</body>

</html>