<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= titulo %> | AutoRentCar
    </title>


    <link
        rel="stylesheet"
        href="/css/admin.css"
    >


    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

</head>


<body>


<div class="admin-shell">


    <%- include("../partials/sidebar") %>


    <div class="admin-content-wrapper">


        <%- include("../partials/header") %>


        <main class="admin-main-content">


            <div class="form-page-top">

                <a
                    href="/admin/agencias/<%= agencia.id %>/vehiculos"
                    class="back-link"
                >

                    <i class="fa-solid fa-arrow-left"></i>

                    Volver a vehículos

                </a>

            </div>



            <section class="agency-profile-hero">


                <div class="agency-profile-main">


                    <div class="agency-profile-info">


                        <span class="profile-label">
                            Unidades físicas
                        </span>


                        <h1>

                            <%= modelo.marca %>
                            <%= modelo.nombre %>

                            <% if (modelo.anio) { %>
                                <%= modelo.anio %>
                            <% } %>

                        </h1>


                        <p>
                            Vehículos físicos registrados para este modelo
                            dentro de <%= agencia.nombre %>.
                        </p>


                    </div>


                </div>


                <div class="agency-profile-status">


                    <span class="plan-badge">

                        <i class="fa-solid fa-layer-group"></i>

                        <%= suscripcion
                            ? suscripcion.plan_nombre
                            : "Sin plan"
                        %>

                    </span>


                </div>


            </section>



            <% if (mensajeExito) { %>

                <div class="admin-alert admin-alert-success">

                    <i class="fa-solid fa-circle-check"></i>


                    <div>

                        <strong>
                            Operación completada
                        </strong>


                        <span>
                            <%= mensajeExito %>
                        </span>

                    </div>

                </div>

            <% } %>



            <section class="dashboard-stats agency-detail-stats">


                <article class="stat-card">

                    <div class="stat-icon stat-icon-blue">

                        <i class="fa-solid fa-cars"></i>

                    </div>

                    <span class="stat-title">
                        Total del modelo
                    </span>

                    <strong class="stat-value">
                        <%= resumen.total %>
                    </strong>

                </article>



                <article class="stat-card">

                    <div class="stat-icon stat-icon-purple">

                        <i class="fa-solid fa-car-side"></i>

                    </div>

                    <span class="stat-title">
                        Activas
                    </span>

                    <strong class="stat-value">
                        <%= resumen.activas %>
                    </strong>

                </article>



                <article class="stat-card">

                    <div class="stat-icon stat-icon-green">

                        <i class="fa-solid fa-circle-check"></i>

                    </div>

                    <span class="stat-title">
                        Disponibles
                    </span>

                    <strong class="stat-value">
                        <%= resumen.disponibles %>
                    </strong>

                </article>



                <article class="stat-card">

                    <div class="stat-icon stat-icon-orange">

                        <i class="fa-solid fa-layer-group"></i>

                    </div>

                    <span class="stat-title">
                        Uso global del plan
                    </span>

                    <strong class="stat-value">

                        <%= vehiculosActivos %>

                        /

                        <% if (
                            !suscripcion ||
                            suscripcion.limite_vehiculos === null
                        ) { %>

                            ∞

                        <% } else { %>

                            <%= suscripcion.limite_vehiculos %>

                        <% } %>

                    </strong>

                </article>


            </section>



            <section class="dashboard-panel">


                <div class="panel-header">


                    <div>

                        <span class="panel-eyebrow">
                            Inventario físico
                        </span>


                        <h3>
                            Unidades registradas
                        </h3>


                        <p>
                            Consulta el estado y ubicación de cada
                            vehículo físico.
                        </p>

                    </div>


                    <% if (modelo.estado === "activo") { %>

                        <a
                            href="/admin/agencias/<%= agencia.id %>/vehiculos/modelos/<%= modelo.id %>/unidades/nueva"
                            class="user-btn-create"
                        >

                            <i class="fa-solid fa-plus"></i>

                            Agregar unidad

                        </a>

                    <% } %>


                </div>



                <div class="table-container">


                    <table class="admin-table">


                        <thead>

                            <tr>

                                <th>
                                    Código
                                </th>

                                <th>
                                    Placa
                                </th>

                                <th>
                                    Sucursal
                                </th>

                                <th>
                                    Color
                                </th>

                                <th>
                                    Kilometraje
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Acción
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                        <% if (unidades.length === 0) { %>

                            <tr>

                                <td
                                    colspan="7"
                                    class="table-empty"
                                >

                                    <div>

                                        <i class="fa-solid fa-car-burst"></i>


                                        <strong>
                                            No hay unidades registradas
                                        </strong>


                                        <span>
                                            Este modelo todavía no tiene
                                            vehículos físicos asociados.
                                        </span>

                                    </div>

                                </td>

                            </tr>

                        <% } %>



                        <% unidades.forEach((unidad) => { %>


                            <tr>


                                <td>

                                    <strong>
                                        <%= unidad.codigo_interno %>
                                    </strong>

                                </td>


                                <td>

                                    <%= unidad.placa || "Sin placa" %>

                                </td>


                                <td>

                                    <strong>
                                        <%= unidad.sucursal_nombre %>
                                    </strong>


                                    <% if (
                                        Number(
                                            unidad.es_principal
                                        ) === 1
                                    ) { %>

                                        <span
                                            class="table-muted"
                                            style="display:block;"
                                        >
                                            Principal
                                        </span>

                                    <% } %>


                                    <% if (
                                        unidad.sucursal_estado !== "activa"
                                    ) { %>

                                        <span
                                            class="table-muted"
                                            style="display:block;"
                                        >
                                            Sucursal inactiva
                                        </span>

                                    <% } %>

                                </td>


                                <td>

                                    <%= unidad.color || "No registrado" %>

                                </td>


                                <td>

                                    <%= Number(
                                        unidad.kilometraje ||
                                        0
                                    ).toLocaleString("es-DO") %>

                                    km

                                </td>


                                <td>


                                    <% if (
                                        unidad.estado === "disponible"
                                    ) { %>

                                        <span class="status-badge status-activa">

                                            <span class="status-dot"></span>

                                            Disponible

                                        </span>


                                    <% } else if (
                                        unidad.estado === "inactivo"
                                    ) { %>

                                        <span class="status-badge status-suspendida">

                                            <span class="status-dot"></span>

                                            Inactivo

                                        </span>


                                    <% } else { %>

                                        <span class="plan-badge">

                                            <%= unidad.estado
                                                .charAt(0)
                                                .toUpperCase()
                                                +
                                                unidad.estado.slice(1)
                                            %>

                                        </span>

                                    <% } %>


                                </td>


                                <td>

                                    <a
                                        href="/admin/agencias/<%= agencia.id %>/vehiculos/modelos/<%= modelo.id %>/unidades/<%= unidad.id %>/editar"
                                        class="table-action"
                                        title="Editar unidad"
                                    >

                                        <i class="fa-solid fa-pen-to-square"></i>

                                    </a>

                                </td>


                            </tr>


                        <% }); %>


                        </tbody>


                    </table>


                </div>


            </section>



            <footer class="admin-footer">

                <span>
                    AutoRentCar Platform
                </span>


                <span>
                    © <%= new Date().getFullYear() %>
                </span>

            </footer>


        </main>


    </div>


</div>


<script src="/js/admin.js"></script>


</body>

</html>