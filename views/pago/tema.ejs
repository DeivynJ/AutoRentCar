<%

    function normalizarHexPago(
        valor,
        respaldo
    ) {

        let color =
            String(
                valor ||
                respaldo
            )
                .trim()
                .toLowerCase();


        if (
            !color.startsWith("#")
        ) {

            color =
                `#${color}`;

        }


        if (
            /^#[0-9a-f]{3}$/i.test(
                color
            )
        ) {

            color =
                `#${color[1]}${color[1]}${color[2]}${color[2]}${color[3]}${color[3]}`;

        }


        return /^#[0-9a-f]{6}$/i.test(
            color
        )
            ? color
            : respaldo;

    }


    function hexARgbPago(
        color
    ) {

        return {

            r:
                parseInt(
                    color.slice(1, 3),
                    16
                ),

            g:
                parseInt(
                    color.slice(3, 5),
                    16
                ),

            b:
                parseInt(
                    color.slice(5, 7),
                    16
                )

        };

    }


    function mezclarPago(
        colorA,
        colorB,
        porcentajeB
    ) {

        const porcentaje =
            Math.max(
                0,
                Math.min(
                    1,
                    porcentajeB
                )
            );


        return {

            r:
                Math.round(
                    colorA.r +
                    (
                        colorB.r -
                        colorA.r
                    ) *
                    porcentaje
                ),

            g:
                Math.round(
                    colorA.g +
                    (
                        colorB.g -
                        colorA.g
                    ) *
                    porcentaje
                ),

            b:
                Math.round(
                    colorA.b +
                    (
                        colorB.b -
                        colorA.b
                    ) *
                    porcentaje
                )

        };

    }


    function luminanciaPago(
        color
    ) {

        function canal(
            valor
        ) {

            const normalizado =
                valor /
                255;


            return normalizado <=
                0.03928
                ? normalizado /
                    12.92
                : Math.pow(
                    (
                        normalizado +
                        0.055
                    ) /
                    1.055,
                    2.4
                );

        }


        return (
            0.2126 *
            canal(color.r)
        ) +
        (
            0.7152 *
            canal(color.g)
        ) +
        (
            0.0722 *
            canal(color.b)
        );

    }


    function contrastePago(
        colorA,
        colorB
    ) {

        const a =
            luminanciaPago(
                colorA
            );


        const b =
            luminanciaPago(
                colorB
            );


        return (
            Math.max(a, b) +
            0.05
        ) /
        (
            Math.min(a, b) +
            0.05
        );

    }


    function asegurarBasePago(
        color
    ) {

        const blanco = {
            r: 255,
            g: 255,
            b: 255
        };


        const negro = {
            r: 0,
            g: 0,
            b: 0
        };


        let resultado = {
            ...color
        };


        let intentos =
            0;


        while (
            contrastePago(
                resultado,
                blanco
            ) < 5 &&
            intentos < 10
        ) {

            resultado =
                mezclarPago(
                    resultado,
                    negro,
                    0.10
                );


            intentos++;

        }


        return resultado;

    }


    function textoContrastePago(
        fondo
    ) {

        const blanco = {
            r: 255,
            g: 255,
            b: 255
        };


        const oscuro = {
            r: 17,
            g: 24,
            b: 39
        };


        return contrastePago(
            fondo,
            oscuro
        ) >
        contrastePago(
            fondo,
            blanco
        )
            ? oscuro
            : blanco;

    }


    function rgbPago(
        color
    ) {

        return `rgb(${color.r}, ${color.g}, ${color.b})`;

    }


    function listaRgbPago(
        color
    ) {

        return `${color.r}, ${color.g}, ${color.b}`;

    }


    const primarioPago =
        normalizarHexPago(
            agencia.colorPrimario,
            "#0b1f3a"
        );


    const secundarioPago =
        normalizarHexPago(
            agencia.colorSecundario,
            "#ff8a00"
        );


    const rgbPrimarioPago =
        hexARgbPago(
            primarioPago
        );


    const rgbSecundarioPago =
        hexARgbPago(
            secundarioPago
        );


    let baseOriginalPago;

    let acentoPago;


    if (
        luminanciaPago(
            rgbPrimarioPago
        ) <=
        luminanciaPago(
            rgbSecundarioPago
        )
    ) {

        baseOriginalPago =
            rgbPrimarioPago;

        acentoPago =
            rgbSecundarioPago;

    } else {

        baseOriginalPago =
            rgbSecundarioPago;

        acentoPago =
            rgbPrimarioPago;

    }


    const basePago =
        asegurarBasePago(
            baseOriginalPago
        );


    const negroPago = {
        r: 0,
        g: 0,
        b: 0
    };


    const blancoPago = {
        r: 255,
        g: 255,
        b: 255
    };


    const baseOscuraPago =
        mezclarPago(
            basePago,
            negroPago,
            0.32
        );


    const tono1Pago =
        mezclarPago(
            basePago,
            blancoPago,
            0.12
        );


    const tono2Pago =
        mezclarPago(
            basePago,
            blancoPago,
            0.24
        );


    const tono3Pago =
        mezclarPago(
            basePago,
            blancoPago,
            0.18
        );


    const tono4Pago =
        mezclarPago(
            basePago,
            blancoPago,
            0.15
        );


    const tono5Pago =
        mezclarPago(
            basePago,
            blancoPago,
            0.21
        );


    const acentoOscuroPago =
        mezclarPago(
            acentoPago,
            negroPago,
            0.14
        );


    const acentoClaroPago =
        mezclarPago(
            acentoPago,
            blancoPago,
            0.26
        );


    const acentoClaro2Pago =
        mezclarPago(
            acentoPago,
            blancoPago,
            0.20
        );


    const acentoSuavePago =
        mezclarPago(
            acentoPago,
            blancoPago,
            0.56
        );


    const acentoSuave2Pago =
        mezclarPago(
            acentoPago,
            blancoPago,
            0.45
        );


    const fondoSuavePago =
        mezclarPago(
            acentoPago,
            blancoPago,
            0.92
        );


    const textoPrincipalPago =
        textoContrastePago(
            basePago
        );


    const textoSecundarioPago =
        textoContrastePago(
            acentoPago
        );

%>


<style>

    :root {

        --color-principal:
            <%= rgbPago(basePago) %>;

        --color-principal-rgb:
            <%= listaRgbPago(basePago) %>;

        --color-principal-oscuro:
            <%= rgbPago(baseOscuraPago) %>;

        --color-principal-oscuro-rgb:
            <%= listaRgbPago(baseOscuraPago) %>;

        --color-principal-tono-1:
            <%= rgbPago(tono1Pago) %>;

        --color-principal-tono-2:
            <%= rgbPago(tono2Pago) %>;

        --color-principal-tono-3:
            <%= rgbPago(tono3Pago) %>;

        --color-principal-tono-4:
            <%= rgbPago(tono4Pago) %>;

        --color-principal-tono-5:
            <%= rgbPago(tono5Pago) %>;

        --color-secundario:
            <%= rgbPago(acentoPago) %>;

        --color-secundario-rgb:
            <%= listaRgbPago(acentoPago) %>;

        --color-secundario-oscuro:
            <%= rgbPago(acentoOscuroPago) %>;

        --color-secundario-claro:
            <%= rgbPago(acentoClaroPago) %>;

        --color-secundario-claro-2:
            <%= rgbPago(acentoClaro2Pago) %>;

        --color-secundario-suave:
            <%= rgbPago(acentoSuavePago) %>;

        --color-secundario-suave-2:
            <%= rgbPago(acentoSuave2Pago) %>;

        --color-azul-claro:
            <%= rgbPago(fondoSuavePago) %>;

        --color-oscuro:
            <%= rgbPago(baseOscuraPago) %>;

        --color-texto-sobre-principal:
            <%= rgbPago(textoPrincipalPago) %>;

        --color-texto-sobre-secundario:
            <%= rgbPago(textoSecundarioPago) %>;

        --color-texto-sobre-secundario-rgb:
            <%= listaRgbPago(textoSecundarioPago) %>;

    }

</style>