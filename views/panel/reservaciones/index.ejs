<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Reservaciones de <%= agencia.nombre %>."
    >

    <title>
        <%= titulo %> | <%= agencia.nombre %>
    </title>

    <%- include("../partials/tema") %>

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <link
        rel="stylesheet"
        href="/css/panel.css"
    >

</head>


<body>

    <div class="panel-shell">

        <%- include("../partials/sidebar") %>


        <div class="panel-content-wrapper">

            <%- include("../partials/header") %>


            <main class="panel-main">


                <!-- =====================================
                     ENCABEZADO
                ====================================== -->

                <section class="panel-module-hero">

                    <div>

                        <span class="panel-module-badge">

                            <i class="fa-solid fa-calendar-check"></i>

                            Operaciones

                        </span>


                        <h2>

                            Reservaciones de

                            <span>
                                <%= agencia.nombre %>
                            </span>

                        </h2>


                        <p>

                            Consulta las solicitudes recibidas
                            y el estado actual de las
                            reservaciones pertenecientes
                            exclusivamente a tu agencia.

                        </p>

                    </div>

                </section>


                <!-- =====================================
                     RESUMEN
                ====================================== -->

                <section class="panel-summary-grid">


                    <article class="panel-summary-card">

                        <div class="panel-summary-icon">

                            <i class="fa-solid fa-calendar-days"></i>

                        </div>

                        <small>
                            Total
                        </small>

                        <strong>
                            <%= resumen.total %>
                        </strong>

                        <span>
                            Reservaciones registradas
                        </span>

                    </article>


                    <article class="panel-summary-card">

                        <div class="panel-summary-icon">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <small>
                            Pendientes
                        </small>

                        <strong>
                            <%= resumen.pendientes %>
                        </strong>

                        <span>
                            Esperando revisión
                        </span>

                    </article>

                    <article class="panel-summary-card">

    <div class="panel-summary-icon">

        <i class="fa-solid fa-credit-card"></i>

    </div>

    <small>
        Pendientes de pago
    </small>

    <strong>
        <%= resumen.pendientesPago %>
    </strong>

    <span>
        Esperando anticipo
    </span>

</article>


                    <article class="panel-summary-card">

                        <div class="panel-summary-icon">

                            <i class="fa-solid fa-circle-check"></i>

                        </div>

                        <small>
                            Confirmadas
                        </small>

                        <strong>
                            <%= resumen.confirmadas %>
                        </strong>

                        <span>
                            Solicitudes aprobadas
                        </span>

                    </article>


                    <article class="panel-summary-card">

                        <div class="panel-summary-icon">

                            <i class="fa-solid fa-car-side"></i>

                        </div>

                        <small>
                            En curso
                        </small>

                        <strong>
                            <%= resumen.enCurso %>
                        </strong>

                        <span>
                            Alquileres activos
                        </span>

                    </article>
                
                </section>

                <!-- =====================================
                     LISTADO
                ====================================== -->

                <section
    class="panel-units-card"
    style="margin-top: 28px;"
>


                    <div class="panel-units-header panel-reservation-list-header">

    <div class="panel-reservation-list-title">

        <span>
            Gestión de reservaciones
        </span>

        <h3>
            Solicitudes registradas
        </h3>

        <p>

            Las reservaciones pendientes
            aparecen primero para facilitar
            su revisión.

        </p>

    </div>


    <!-- =====================================
         FILTROS DEL MISMO LISTADO
    ====================================== -->

    <form
        action="/panel/reservaciones"
        method="get"
        class="panel-reservation-filters"
        role="search"
    >


        <!-- BÚSQUEDA -->

        <div class="panel-reservation-search">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input
                type="search"
                name="busqueda"
                value="<%= filtros.busqueda %>"
                maxlength="120"
                placeholder="Buscar reservación..."
                aria-label="Buscar reservación"
            >

        </div>


        <!-- ESTADO -->

        <select
            name="estado"
            aria-label="Filtrar por estado"
            title="Estado"
        >

            <option value="">
                Todos los estados
            </option>

            <option
                value="pendiente"
                <%= filtros.estado === "pendiente"
                    ? "selected"
                    : "" %>
            >
                Pendientes
            </option>

            <option
                value="pendiente_pago"
                <%= filtros.estado === "pendiente_pago"
                    ? "selected"
                    : "" %>
            >
                Pendientes de pago
            </option>

            <option
                value="confirmada"
                <%= filtros.estado === "confirmada"
                    ? "selected"
                    : "" %>
            >
                Confirmadas
            </option>

            <option
                value="en_curso"
                <%= filtros.estado === "en_curso"
                    ? "selected"
                    : "" %>
            >
                En curso
            </option>

            <option
                value="finalizada"
                <%= filtros.estado === "finalizada"
                    ? "selected"
                    : "" %>
            >
                Finalizadas
            </option>

            <option
                value="rechazada"
                <%= filtros.estado === "rechazada"
                    ? "selected"
                    : "" %>
            >
                Rechazadas
            </option>

            <option
                value="cancelada"
                <%= filtros.estado === "cancelada"
                    ? "selected"
                    : "" %>
            >
                Canceladas
            </option>

        </select>


        <!-- ORIGEN -->

        <select
            name="origen"
            aria-label="Filtrar por origen"
            title="Origen"
        >

            <option value="">
                Todos los orígenes
            </option>

            <option
                value="web"
                <%= filtros.origen === "web"
                    ? "selected"
                    : "" %>
            >
                Web
            </option>

            <option
                value="panel"
                <%= filtros.origen === "panel"
                    ? "selected"
                    : "" %>
            >
                Panel
            </option>

        </select>


        <!-- FILTRAR -->

        <button
            type="submit"
            class="panel-reservation-filter-button"
            title="Aplicar filtros"
        >

            <i class="fa-solid fa-filter"></i>

            <span>
                Filtrar
            </span>

        </button>


        <!-- LIMPIAR -->

        <a
            href="/panel/reservaciones"
            class="panel-reservation-filter-clear"
            title="Limpiar filtros"
            aria-label="Limpiar filtros"
        >

            <i class="fa-solid fa-rotate-left"></i>

        </a>

    </form>

</div>


                    <% if (reservaciones.length) { %>

                        <%
function horaSegura(valor) {

    if (!valor) {

        return "—";

    }


    const texto =
        String(valor)
            .trim()
            .slice(0, 5);


    const partes =
        texto.split(":");


    if (
        partes.length !== 2
    ) {

        return texto;

    }


    let hora =
        Number(
            partes[0]
        );


    const minutos =
        partes[1];


    const periodo =
        hora >= 12
            ? "p.m."
            : "a.m.";


    hora =
        hora % 12;


    if (
        hora === 0
    ) {

        hora = 12;

    }


    return `${hora}:${minutos} ${periodo}`;

}
%>


                        <div class="panel-units-table-wrapper">

                            <table class="panel-units-table">

                                <thead>

                                    <tr>

                                        <th>
                                            Código
                                        </th>

                                        <th>
                                            Cliente
                                        </th>

                                        <th>
                                            Vehículo
                                        </th>

                                        <th>
                                            Cantidad
                                        </th>

                                        <th>
                                            Recogida
                                        </th>

                                        <th>
                                            Devolución
                                        </th>

                                        <th>
                                            Total
                                        </th>

                                        <th>
                                            Estado
                                        </th>

                                        <th>
                                            Origen
                                        </th>

                                        <th>
                                             Acción
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% reservaciones.forEach((reservacion) => { %>

                                        <%

                                           let claseEstado =
    "unit-status-reservado";


const requierePagoReservacion =
    Number(
        reservacion.monto_anticipo_requerido ||
        0
    ) > 0;


const cantidadSolicitada =
    Number(
        reservacion.cantidad_vehiculos ||
        0
    );


const cantidadAsignada =
    Number(
        reservacion.unidades_asignadas ||
        0
    );


const asignacionCompleta =
    cantidadSolicitada > 0 &&
    cantidadAsignada >= cantidadSolicitada;


let nombreEstado =
    reservacion.estado;


if (
    reservacion.estado ===
    "pendiente"
) {

    nombreEstado =
        "Pendiente de confirmación";

}


if (
    reservacion.estado ===
    "pendiente_pago"
) {

    claseEstado =
        "unit-status-reservado";

    nombreEstado =
        "Reservación confirmada · Pendiente de pago";

}


if (
    reservacion.estado ===
    "confirmada"
) {

    claseEstado =
        "unit-status-disponible";


    if (
        requierePagoReservacion
    ) {

        nombreEstado =
            asignacionCompleta
                ? "Pago confirmado · Pendiente de entrega"
                : "Pago confirmado · Pendiente de asignar unidad";

    } else {

        nombreEstado =
            asignacionCompleta
                ? "Reservación confirmada · Pendiente de entrega"
                : "Reservación confirmada · Pendiente de asignar unidad";

    }

}


if (
    reservacion.estado ===
    "en_curso"
) {

    claseEstado =
        "unit-status-alquilado";

    nombreEstado =
        "Alquiler en curso";

}


if (
    [
        "finalizada",
        "rechazada",
        "cancelada"
    ].includes(
        reservacion.estado
    )
) {

    claseEstado =
        "unit-status-inactivo";

}


if (
    reservacion.estado ===
    "finalizada"
) {

    nombreEstado =
        "Reservación finalizada";

}


if (
    reservacion.estado ===
    "rechazada"
) {

    nombreEstado =
        "Reservación rechazada";

}


if (
    reservacion.estado ===
    "cancelada"
) {

    nombreEstado =
        "Reservación cancelada";

}


                                            const fechaRecogida =
                                                reservacion.fecha_recogida
                                                    ? new Date(
                                                        reservacion.fecha_recogida
                                                    )
                                                        .toISOString()
                                                        .slice(
                                                            0,
                                                            10
                                                        )
                                                    : "—";


                                            const fechaEntrega =
                                                reservacion.fecha_entrega
                                                    ? new Date(
                                                        reservacion.fecha_entrega
                                                    )
                                                        .toISOString()
                                                        .slice(
                                                            0,
                                                            10
                                                        )
                                                    : "—";

                                        %>


                                        <tr>


                                            <td>

                                                <strong>
                                                    <%= reservacion.codigo %>
                                                </strong>

                                            </td>


                                            <td>

                                                <strong>
                                                    <%= reservacion.cliente_nombre %>
                                                </strong>

                                                <br>

                                                <small>
                                                    <%= reservacion.cliente_correo %>
                                                </small>

                                            </td>


                                            <td>

                                                <strong>
                                                    <%= reservacion.modelo_marca %>
                                                    <%= reservacion.modelo_nombre %>
                                                </strong>

                                            </td>


                                            <td>

                                                <%= reservacion.cantidad_vehiculos %>

                                            </td>


                                            <td>

                                                <%= fechaRecogida %>

                                                <br>

                                                <small>
                                                    <%= horaSegura(
                                                        reservacion.hora_recogida
                                                        
                                                        ) %>
                                                </small>

                                            </td>


                                            <td>

                                                <%= fechaEntrega %>

                                                <br>

                                                <small>
                                                    <%= horaSegura(
                                                        reservacion.hora_entrega
                                                        
                                                        ) %>
                                                </small>

                                            </td>


                                            <td>

                                                <strong>

                                                    US$<%= Number(
                                                        reservacion.total ||
                                                        0
                                                    ).toFixed(2) %>

                                                </strong>

                                            </td>


                                            <td>

    <span

    class="unit-status reservation-status-text <%= claseEstado %>"
    >

        <%= nombreEstado %>

    </span>  

</td>


                                            <td>

                                                <%= reservacion.origen === "web"
                                                    ? "Web"
                                                    : "Panel" %>

                                            </td>

                                            <td>

    <a
        href="/panel/reservaciones/<%= reservacion.id %>"
        class="panel-secondary-button"
    >

        <i class="fa-solid fa-eye"></i>

        Ver detalle

    </a>

</td>


                                        </tr>

                                    <% }); %>

                                </tbody>

                            </table>

                        </div>


                    <% } else { %>

    <%
        const hayFiltrosActivos =
            Boolean(
                filtros.busqueda ||
                filtros.estado ||
                filtros.origen ||
                filtros.fechaDesde ||
                filtros.fechaHasta
            );
    %>


    <div class="catalog-empty">

        <div>

            <i
                class="fa-solid
                <%= hayFiltrosActivos
                    ? 'fa-magnifying-glass'
                    : 'fa-calendar-check' %>"
            ></i>

        </div>


        <h3>

            <%= hayFiltrosActivos
                ? "No se encontraron reservaciones"
                : "Todavía no hay reservaciones" %>

        </h3>


        <p>

            <% if (hayFiltrosActivos) { %>

                No hay solicitudes que coincidan
                con los filtros seleccionados.
                Puedes modificar los criterios
                o limpiar los filtros para volver
                a ver el listado completo.

            <% } else { %>

                Las nuevas solicitudes recibidas
                para esta agencia aparecerán aquí
                automáticamente.

            <% } %>

        </p>

    </div>


<% } %>


                </section>


            </main>


        </div>


    </div>


    <script src="/js/panel.js"></script>

</body>

</html>