                <div>

                    <span>
                        Cantidad
                    </span>

                    <strong>

                        <%= reservacion.cantidad_vehiculos %>

                        <%= Number(
                            reservacion.cantidad_vehiculos || 0
                        ) === 1
                            ? "vehículo"
                            : "vehículos"
                        %>

                    </strong>

                </div>


                <div>

                    <span>
                        Precio diario
                    </span>

                    <strong>

                        US$<%= moneda(
