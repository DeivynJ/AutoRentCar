            %>

        </small>


        <i class="fa-solid fa-chevron-down"></i>

    </span>


</summary>



        <div class="reservation-compact-details-body">


            <% if (pagosSeguros.length) { %>


                <div class="reservation-compact-payments">


                    <% pagosSeguros.forEach((pago) => { %>


                        <%

                            let nombreEstadoPago =
                                pago.estado;


                            let claseEstadoPago =
                                "unit-status-reservado";


                            let nombreOrigenPago =
                                pago.origen;


                            if (
                                pago.estado ===
                                "pendiente_validacion"
                            ) {

                                nombreEstadoPago =
                                    "Pendiente de validación";

                            }


                            if (
                                pago.estado ===
                                "confirmado"
                            ) {

                                nombreEstadoPago =
                                    "Confirmado";

                                claseEstadoPago =
                                    "unit-status-disponible";

                            }


                            if (
                                pago.estado ===
                                "rechazado"
                            ) {

                                nombreEstadoPago =
                                    "Rechazado";

                                claseEstadoPago =
                                    "unit-status-inactivo";

                            }


                            if (
                                pago.estado ===
                                "anulado"
                            ) {

                                nombreEstadoPago =
                                    "Anulado";

                                claseEstadoPago =
                                    "unit-status-inactivo";

                            }


                            if (
                                pago.origen ===
                                "cliente"
                            ) {

                                nombreOrigenPago =
                                    "Cliente";

                            }


                            if (
                                pago.origen ===
                                "panel"
                            ) {

                                nombreOrigenPago =
                                    "Panel";

                            }


                            if (
                                pago.origen ===
                                "pasarela"
                            ) {

                                nombreOrigenPago =
                                    "Pasarela";

                            }

                        %>



                        <article class="reservation-compact-payment-row">


                            <div class="reservation-compact-payment-main">


                                <div>


                                    <strong>
                                        <%= pago.metodo_nombre %>
                                    </strong>


                                    <span>

                                        <%= pago.moneda %>$<%= moneda(
                                            pago.monto
                                        ) %>

                                        ·

                                        <%= fechaSegura(
                                            pago.fecha_pago
                                        ) %>

                                    </span>


                                </div>


                                <span
                                    class="unit-status <%= claseEstadoPago %>"
                                >

                                    <%= nombreEstadoPago %>

                                </span>


                            </div>



                            <div class="reservation-compact-payment-meta">


                                <div>

                                    <strong>
                                        Referencia
                                    </strong>

                                    <span>
                                        <%= pago.referencia || "No registrada" %>
                                    </span>

                                </div>


                                <div>

                                    <strong>
                                        Origen
                                    </strong>

                                    <span>
                                        <%= nombreOrigenPago %>
                                    </span>

                                </div>


                                <div>

                                    <strong>
                                        Tipo
                                    </strong>

                                    <span>
                                        <%= pago.metodo_tipo || "No especificado" %>
                                    </span>

                                </div>


                            </div>



                            <% if (
                                pago.comprobante_ruta
                            ) { %>


                                <div class="reservation-compact-proof">


                                    <div>

                                        <i class="fa-solid fa-file-invoice"></i>


                                        <span>

                                            <%= pago.comprobante_nombre_original
                                                || "Comprobante registrado"
                                            %>

                                        </span>

                                    </div>



                                    <% if (
                                        puedeValidarPagos
                                    ) { %>


                                        <a
                                            href="/panel/pagos/<%= pago.id %>/comprobante"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="panel-secondary-button"
                                        >

                                            <i class="fa-solid fa-eye"></i>

                                            Ver comprobante

                                        </a>


                                    <% } %>


                                </div>


                            <% } %>

<% if (
    pago.estado === "pendiente_validacion" &&
    puedeValidarPagos
) { %>


    <div class="reservation-compact-payment-actions">


        <% if (
            Number(
                reservacion.antes_recogida
            ) === 1
        ) { %>


            <form
                action="/panel/pagos/<%= pago.id %>/confirmar"
                method="POST"
            >


                <button
                    type="submit"
                    class="reservation-compact-button reservation-compact-approve"
                    onclick="return confirm('¿Confirmar este pago de <%= pago.moneda %>$<%= moneda(pago.monto) %>? Esta acción registrará el pago como validado.');"
                >

                    <i class="fa-solid fa-circle-check"></i>

                    Confirmar pago

                </button>


            </form>


        <% } %>


        <details class="reservation-payment-reject-details">


            <summary>

                <i class="fa-solid fa-circle-xmark"></i>

                Rechazar pago

            </summary>


            <form
                action="/panel/pagos/<%= pago.id %>/rechazar"
                method="POST"
            >


                <label>

                    Motivo del rechazo

                    <textarea
                        name="motivo"
                        required
                        minlength="3"
                        maxlength="500"
                        rows="2"
                        placeholder="Escribe el motivo del rechazo"
                    ></textarea>

                </label>


                <button
                    type="submit"
                    class="reservation-compact-button reservation-compact-reject"
                    onclick="return confirm('¿Seguro que deseas rechazar este comprobante de pago?');"
                >

                    Confirmar rechazo

                </button>


            </form>


        </details>


    </div>


                            <% } else if (
                                pago.estado === "pendiente_validacion" &&
                                !puedeValidarPagos
                            ) { %>


                                <div class="reservation-compact-payment-note">


                                    <i class="fa-solid fa-clock"></i>


                                    <span>

                                        Pendiente de revisión por
                                        un administrador de la agencia.

                                    </span>


                                </div>


                            <% } else if (
                                pago.estado === "rechazado" &&
                                pago.motivo_rechazo
                            ) { %>


                                <div class="reservation-compact-payment-note rejected">


                                    <i class="fa-solid fa-circle-xmark"></i>


                                    <span>
                                        <%= pago.motivo_rechazo %>
                                    </span>


                                </div>


                            <% } %>


                        </article>


                    <% }); %>


                </div>


            <% } else { %>


                <p class="reservation-compact-empty">

                    Esta reservación todavía
                    no tiene pagos registrados.

                </p>


            <% } %>


        </div>


    </details>


    <!-- =================================
         FACTURACIÓN
    ================================== -->

    <details class="reservation-compact-details reservation-detail-billing">


    <summary>


        <span class="reservation-detail-summary-main">

            <span class="reservation-detail-summary-icon">

                <i class="fa-solid fa-receipt"></i>

            </span>


            <span class="reservation-detail-summary-copy">

                <strong>
                    Desglose de facturación
                </strong>

                <small>
                    Detalle de costos, descuentos y total.
                </small>

            </span>

        </span>


        <span class="reservation-detail-summary-side">

            <small class="reservation-detail-badge">

                US$<%= moneda(
                    resumenPago.total
                ) %>

            </small>


            <i class="fa-solid fa-chevron-down"></i>

        </span>


    </summary>



        <div class="reservation-compact-details-body">


            <div class="reservation-compact-billing">


                <div>

                    <span>
                        Subtotal
                    </span>

                    <strong>

                        US$<%= moneda(
                            resumenPago.subtotal
                        ) %>

                    </strong>

                </div>



                <div>

                    <span>
                        Servicios adicionales
                    </span>

                    <strong>

                        US$<%= moneda(
                            resumenPago.adicionales
                        ) %>

                    </strong>

                </div>



                <div>

                    <span>
                        Descuento
                    </span>

                    <strong>

                        - US$<%= moneda(
                            resumenPago.descuento
                        ) %>

                    </strong>

                </div>



                <div>

                    <span>
                        Código promocional
                    </span>

                    <strong>

                        <%= reservacion.codigo_promocional
                            || "No aplicado"
                        %>

                    </strong>

                </div>



                <div class="reservation-compact-billing-total">

                    <span>
                        Total
                    </span>

                    <strong>

                        US$<%= moneda(
                            resumenPago.total
                        ) %>

                    </strong>

                </div>


            </div>


        </div>


    </details>





    <!-- =================================
         COMENTARIOS
    ================================== -->

    <details class="reservation-compact-details reservation-detail-comments">


    <summary>


        <span class="reservation-detail-summary-main">

            <span class="reservation-detail-summary-icon">

                <i class="fa-regular fa-comment-dots"></i>

            </span>


            <span class="reservation-detail-summary-copy">

                <strong>
                    Comentarios del cliente
                </strong>

                <small>
                    Notas y observaciones realizadas por el cliente.
                </small>

            </span>

        </span>


        <span class="reservation-detail-summary-side">

            <% if (
                String(
                    reservacion.comentarios ||
                    ""
                ).trim()
            ) { %>

                <small class="reservation-detail-badge">
                    1 comentario
                </small>

            <% } %>


            <i class="fa-solid fa-chevron-down"></i>

        </span>


    </summary>



        <div class="reservation-compact-details-body">


            <p class="reservation-compact-comment">

                <%= reservacion.comentarios
                    || "El cliente no agregó comentarios a esta reservación."
                %>

            </p>


        </div>


    </details>


</section>


        

            </main>

        </div>

    </div>


    <script src="/js/panel.js"></script>

</body>

</html>