                <%

                    function fechaSegura(valor) {

                        if (!valor) {

                            return "—";

                        }


                        const fecha =
                            new Date(
                                valor
                            );


                        if (
                            Number.isNaN(
                                fecha.getTime()
                            )
                        ) {

                            return "—";

                        }


                        return fecha
                            .toISOString()
                            .slice(
                                0,
                                10
                            );

                    }


                    function horaSegura(valor) {

    if (!valor) {

        return "—";

    }


    const texto =
        String(valor)
            .trim()
            .slice(0, 5);


    const partes =
        texto.split(":");


    if (
        partes.length !== 2
    ) {

        return texto;

    }


    let hora =
        Number(
            partes[0]
        );


    const minutos =
        partes[1];


    const periodo =
        hora >= 12
            ? "p.m."
            : "a.m.";


    hora =
        hora % 12;


    if (
        hora === 0
    ) {

        hora = 12;

    }


    return `${hora}:${minutos} ${periodo}`;

}


                    function moneda(valor) {

                        return Number(
                            valor ||
                            0
                        ).toFixed(
                            2
                        );

                    }

                    const requierePagoReservacion =
    Number(
        resumenPago?.montoAnticipoRequerido ||
        0
    ) > 0;


const tieneUnidadAsignada =
    Number(
        unidadesReservacion?.cantidadAsignada ||
        0
    ) > 0;


const nombresEstadoReservacion = {

    pendiente:
        "Pendiente de confirmación",

    pendiente_pago:
        "Reservación confirmada · Pendiente de pago",

    confirmada:
        requierePagoReservacion
            ? (
                tieneUnidadAsignada
                    ? "Pago confirmado · Pendiente de entrega"
                    : "Pago confirmado · Pendiente de asignar unidad"
            )
            : (
                tieneUnidadAsignada
                    ? "Reservación confirmada · Pendiente de entrega"
                    : "Reservación confirmada · Pendiente de asignar unidad"
            ),

    en_curso:
        "Alquiler en curso",

    finalizada:
        "Reservación finalizada",

    rechazada:
        "Reservación rechazada",

    cancelada:
        "Reservación cancelada"

};


const descripcionesEstadoReservacion = {

    pendiente:
        "Esperando la decisión del administrador.",

    pendiente_pago:
        "La agencia aceptó la reservación y está pendiente de completar el pago.",

    confirmada:
        requierePagoReservacion
            ? (
                tieneUnidadAsignada
                    ? "El pago fue validado y el vehículo está pendiente de entrega."
                    : "El pago fue validado y falta asignar la unidad física."
            )
            : (
                tieneUnidadAsignada
                    ? "La reservación está confirmada y el vehículo está pendiente de entrega."
                    : "La reservación está confirmada y falta asignar la unidad física."
            ),

    en_curso:
        "El vehículo fue entregado y el alquiler está en curso.",

    finalizada:
        "El alquiler fue completado.",

    rechazada:
        "La solicitud fue rechazada por la agencia.",

    cancelada:
        "La reservación fue cancelada."

};


const nombreEstadoReservacion =
    nombresEstadoReservacion[
        reservacion.estado
    ] ||
    reservacion.estado;


const descripcionEstadoReservacion =
    descripcionesEstadoReservacion[
        reservacion.estado
    ] ||
    "Estado actual de la reservación.";

    const nombreRolUsuario =
    String(
        usuario?.rolNombre ||
        ""
    )
        .trim()
        .toLowerCase();


const puedeValidarPagos =
    nombreRolUsuario ===
    "administrador de agencia";

const puedeGestionarUnidades =
    nombreRolUsuario ===
    "administrador de agencia";


    const esEmpleadoPanel =
    nombreRolUsuario === "empleado";


const cantidadUnidadesSolicitadas =
    Number(
        unidadesReservacion?.cantidadSolicitada ||
        0
    );


const cantidadUnidadesAsignadas =
    Number(
        unidadesReservacion?.cantidadAsignada ||
        0
    );


const unidadesCompletamenteAsignadas =
    cantidadUnidadesSolicitadas > 0 &&
    cantidadUnidadesAsignadas ===
        cantidadUnidadesSolicitadas;


const puedeEntregarVehiculo =
    (
        puedeGestionarUnidades ||
        esEmpleadoPanel
    ) &&
    reservacion.estado === "confirmada" &&
    unidadesCompletamenteAsignadas &&
    Number(
        reservacion.periodo_activo
    ) === 1;

    const puedeRegistrarDevolucion =
    (
        puedeGestionarUnidades ||
        esEmpleadoPanel
    ) &&
    reservacion.estado === "en_curso" &&
    unidadesCompletamenteAsignadas;
    

                    let claseEstado =
                        "unit-status-reservado";


                    if (
                        reservacion.estado ===
                        "confirmada"
                    ) {

                        claseEstado =
                            "unit-status-disponible";

                    }


                    if (
                        reservacion.estado ===
                        "en_curso"
                    ) {

                        claseEstado =
                            "unit-status-alquilado";

                    }


                    if (
                        [
                            "finalizada",
                            "rechazada",
                            "cancelada"
                        ].includes(
                            reservacion.estado
                        )
                    ) {

                        claseEstado =
                            "unit-status-inactivo";

                    }

