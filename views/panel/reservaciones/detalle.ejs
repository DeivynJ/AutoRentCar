                <i class="fa-solid fa-car-rear"></i>

            </span>


            <span class="reservation-detail-summary-copy">

                <strong>
                    Unidades físicas
                </strong>

                <small>
                    Vehículos asignados a la reservación.
                </small>

            </span>

        </span>


        <span class="reservation-detail-summary-side">

            <small class="reservation-detail-badge">

                <%= unidadesReservacion.cantidadAsignada %>/<%= unidadesReservacion.cantidadSolicitada %>
