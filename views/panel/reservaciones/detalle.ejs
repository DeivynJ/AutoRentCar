<!-- =====================================
     MENSAJES DE RESULTADO
====================================== -->

<% if (String(queryResultado || "") === "confirmada") { %>

    <div class="panel-reservation-message success">

        <i class="fa-solid fa-circle-check"></i>

        <span>
            La reservación fue confirmada correctamente.
        </span>

    </div>

<% } %>

<% if (String(queryResultado || "") === "pendiente_pago") { %>

