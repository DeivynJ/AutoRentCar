<% } %>


<% if (String(queryError || "") === "devolucion_fallida") { %>

    <div class="panel-reservation-message danger">

        <i class="fa-solid fa-circle-xmark"></i>

        <span>
            No fue posible finalizar correctamente la reservación.
        </span>

    </div>

<% } %>


<% if (String(queryError || "") === "registrar_devolucion") { %>

    <div class="panel-reservation-message danger">

        <i class="fa-solid fa-circle-xmark"></i>

        <span>
            Ocurrió un error al registrar la devolución del vehículo.
        </span>

    </div>

<% } %>


                <!-- =====================================
                     NAVEGACIÓN
                ====================================== -->

                <section class="panel-module-hero reservation-detail-hero">

    <div>

        <a
            href="/panel/reservaciones"
            class="panel-secondary-button"
        >

            <i class="fa-solid fa-arrow-left"></i>

            Volver a reservaciones

        </a>


        <span class="panel-module-badge">

            <i class="fa-solid fa-calendar-check"></i>

            Reservación

        </span>


        <h2>

            <span>
                <%= reservacion.codigo %>
            </span>

        </h2>


        <p>

            Consulta la información completa
            de esta reservación perteneciente
            a <%= agencia.nombre %>.

        </p>

    </div>


    <% if (
        reservacion.estado === "pendiente" &&
        puedeValidarPagos
    ) { %>

        <div class="panel-module-actions reservation-detail-hero-actions">


            <% if (
                Number(
                    reservacion.antes_recogida
                ) === 1
            ) { %>

                <form
                    action="/panel/reservaciones/<%= reservacion.id %>/confirmar"
                    method="POST"
                    onsubmit="return confirm('¿Aprobar la reservación <%= reservacion.codigo %>? Se aplicará la política de pago configurada para la agencia.');"
                >

                    <button
                        type="submit"
                        class="reservation-compact-button reservation-compact-approve"
                    >

                        <i class="fa-solid fa-circle-check"></i>

                        Aprobar reservación

                    </button>

                </form>

            <% } %>


            <details class="reservation-booking-reject-details">


    <summary>

        <i class="fa-solid fa-circle-xmark"></i>

        Rechazar reservación

    </summary>


    <form
        action="/panel/reservaciones/<%= reservacion.id %>/rechazar"
        method="POST"
        onsubmit="return confirm('¿Confirmar el rechazo de la reservación <%= reservacion.codigo %>? El cliente recibirá el motivo indicado.');"
    >


        <label>

            Motivo del rechazo

            <textarea
                name="motivo"
                required
                minlength="3"
                maxlength="500"
                rows="3"
                placeholder="Indica por qué la agencia no puede aprobar esta reservación"
            ></textarea>

        </label>


        <small>

            Este motivo se guardará en la reservación
            y se enviará al cliente por correo.

        </small>


        <button
            type="submit"
            class="reservation-compact-button reservation-compact-reject"
        >

            <i class="fa-solid fa-circle-xmark"></i>

            Confirmar rechazo

        </button>


    </form>


</details>


        </div>

    <% } %>

</section>


