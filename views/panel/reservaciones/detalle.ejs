                            ) %>

                            ·

                            <%= horaSegura(
                                reservacion.hora_entrega
                            ) %>

                        </strong>

                    </div>


                    <div>

                        <span>
                            Lugar de devolución
                        </span>

                        <strong>

                            <%= reservacion.lugar_entrega
                                || "No registrado"
