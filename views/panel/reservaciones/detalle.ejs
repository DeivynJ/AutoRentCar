                    </small>

                    <strong>
                        <%= unidadesReservacion.cantidadSolicitada %>
                    </strong>

                    <span>
                        Vehículos requeridos
                    </span>

                </div>

            </article>


            <article class="reservation-units-metric">

                <span class="reservation-units-metric-icon">

                    <i class="fa-solid fa-circle-check"></i>

