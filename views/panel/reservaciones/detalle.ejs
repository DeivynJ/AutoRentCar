    </div>

<% } %>

<% if (String(queryResultado || "") === "vehiculo_entregado") { %>

    <div class="panel-reservation-message success">

        <i class="fa-solid fa-circle-check"></i>

        <span>
            El vehículo fue entregado correctamente. El alquiler está en curso.
        </span>

    </div>

<% } %>

<% if (String(queryResultado || "") === "vehiculo_devuelto") { %>

    <div class="panel-reservation-message success">

        <i class="fa-solid fa-circle-check"></i>

        <span>
            La devolución fue registrada correctamente. La reservación ha finalizado.
        </span>

