                        </small>

                        <strong>
                            Devolución
                        </strong>

                    </div>


                </div>


                <div class="reservation-rental-point-data">


                    <div>

                        <span>
                            Fecha y hora
                        </span>

                        <strong>

                            <%= fechaSegura(
