                    </span>

                </div>

            </article>


        </div>


        <!-- =================================
             UNIDADES YA ASIGNADAS
        ================================== -->

        <% if (
            unidadesReservacion.unidadesAsignadas.length
        ) { %>


            <section class="reservation-units-section">


                <div class="reservation-units-section-header">


                    <span class="reservation-units-section-icon">

                        <i class="fa-solid fa-car-rear"></i>

                    </span>


                    <div>

                        <strong>
                            Unidades asignadas
                        </strong>

                        <small>
                            Vehículos físicos vinculados a esta reservación.
                        </small>

                    </div>


                </div>


                <div class="reservation-units-list">


                    <% unidadesReservacion.unidadesAsignadas.forEach(
                        (unidad) => {
                    %>


                        <article class="reservation-unit-card">


                            <span class="reservation-unit-card-icon">

                                <i class="fa-solid fa-car-side"></i>

                            </span>


                            <div class="reservation-unit-card-main">

                                <small>
                                    Unidad física
                                </small>

                                <strong>
                                    <%= unidad.codigo_interno %>
                                </strong>


                                <div class="reservation-unit-card-meta">


                                    <span>

                                        <i class="fa-solid fa-id-card"></i>

                                        <%= unidad.placa || "Sin placa" %>

                                    </span>


                                    <span>

                                        <i class="fa-solid fa-building"></i>

                                        <%= unidad.sucursal_nombre || "Sin sucursal" %>

                                    </span>


                                </div>


                            </div>


                            <span class="reservation-unit-status assigned">

                                <i class="fa-solid fa-circle-check"></i>

                                Asignada

                            </span>


                        </article>


                    <% }); %>


                </div>


            </section>


        <% } else { %>


            <div class="reservation-units-state">


                <span>

                    <i class="fa-solid fa-car"></i>

                </span>


                <div>

                    <strong>
                        Sin unidades asignadas
                    </strong>

                    <small>
                        Esta reservación todavía no tiene vehículos físicos vinculados.
                    </small>

                </div>


            </div>


        <% } %>


        <!-- =================================
             UNIDADES DISPONIBLES
        ================================== -->

        <% if (
            unidadesReservacion.puedeAsignar &&
            Number(
                reservacion.antes_recogida
            ) === 1
        ) { %>


            <section class="reservation-units-section reservation-units-available">


                <div class="reservation-units-section-header">


                    <span class="reservation-units-section-icon">

                        <i class="fa-solid fa-square-plus"></i>

                    </span>


                    <div>

                        <strong>
                            Unidades disponibles
                        </strong>

                        <small>
                            Selecciona una unidad compatible para esta reservación.
                        </small>

                    </div>


                </div>


                <% if (
                    unidadesReservacion.unidadesCandidatas.length
                ) { %>


                    <div class="reservation-units-list">


                        <% unidadesReservacion.unidadesCandidatas.forEach(
                            (unidad) => {
                        %>


                            <article class="reservation-unit-card available">


                                <span class="reservation-unit-card-icon">

                                    <i class="fa-solid fa-car-side"></i>

                                </span>


                                <div class="reservation-unit-card-main">

                                    <small>
                                        Unidad disponible
                                    </small>

                                    <strong>
                                        <%= unidad.codigo_interno %>
                                    </strong>


                                    <div class="reservation-unit-card-meta">


                                        <span>

                                            <i class="fa-solid fa-id-card"></i>

                                            <%= unidad.placa || "Sin placa" %>

                                        </span>


                                        <span>

                                            <i class="fa-solid fa-building"></i>

                                            <%= unidad.sucursal_nombre || "Sin sucursal" %>

                                        </span>


                                    </div>


                                </div>


                                <% if (puedeGestionarUnidades) { %>


                                    <form
                                        method="POST"
                                        action="/panel/reservaciones/<%= reservacion.id %>/unidades/asignar"
                                    >

                                        <input
                                            type="hidden"
                                            name="vehiculoId"
                                            value="<%= unidad.id %>"
                                        >


                                        <button
                                            type="submit"
                                            class="reservation-unit-assign-button"
                                        >

                                            <i class="fa-solid fa-link"></i>

                                            Asignar

                                        </button>

                                    </form>


                                <% } else { %>


                                    <span class="reservation-unit-status available">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Disponible

                                    </span>


                                <% } %>


                            </article>


                        <% }); %>


                    </div>


                <% } else { %>


                    <div class="reservation-units-state warning">


                        <span>

                            <i class="fa-solid fa-triangle-exclamation"></i>

                        </span>


                        <div>

                            <strong>
                                Sin unidades disponibles
                            </strong>

                            <small>
                                No hay unidades compatibles disponibles para este período.
                            </small>

                        </div>


                    </div>


                <% } %>


            </section>


        <% } else if (
            reservacion.estado === "confirmada"
        ) { %>


            <div class="reservation-units-state success">


                <span>

                    <i class="fa-solid fa-circle-check"></i>

                </span>


                <div>

                    <strong>
                        Asignación completada
                    </strong>

                    <small>
                        La cantidad de vehículos solicitada ya está completamente asignada.
                    </small>

                </div>


            </div>


        <% } else { %>


            <div class="reservation-units-state info">


                <span>

                    <i class="fa-solid fa-circle-info"></i>

                </span>


                <div>

                    <strong>
                        Asignación aún no disponible
                    </strong>

                    <small>
                        Las unidades físicas podrán asignarse cuando la reservación esté confirmada.
                    </small>

                </div>


            </div>


        <% } %>


    </div>


</div>


    </details>


    <% if (puedeEntregarVehiculo) { %>


        <div class="reservation-compact-action">


            <form
                method="POST"
                action="/panel/reservaciones/<%= reservacion.id %>/entregar"
                onsubmit="return confirm('¿Confirmas que el vehículo fue entregado al cliente? La reservación pasará a alquiler en curso.');"
