                </section>

                <%

    const pagosSeguros =
        Array.isArray(pagos)
            ? pagos
            : [];


    const pagosPendientesValidacion =
        pagosSeguros.filter(
            (pago) =>
                pago.estado ===
                "pendiente_validacion"
        );


    const pagosConfirmados =
        pagosSeguros.filter(
            (pago) =>
                pago.estado ===
                "confirmado"
        );


    const totalPagadoConfirmado =
        pagosConfirmados.reduce(
            (total, pago) =>
                total +
                Number(
                    pago.monto ||
                    0
                ),
            0
        );

%>



<!-- =====================================
     DECISIÓN DE LA RESERVACIÓN
====================================== -->

<section class="panel-units-card reservation-compact-decision">


    <div class="reservation-compact-section-header">


        <div>


            <span>
                Gestión
            </span>


            <h3>
                Decisión de la reservación
            </h3>


            <p>

                Reservación

                <strong>
                    <%= reservacion.codigo %>
                </strong>

            </p>


        </div>


        <span
            class="unit-status <%= claseEstado %>"
        >

            <%= nombreEstadoReservacion %>

        </span>


    </div>



    <% if (
        reservacion.estado === "pendiente" &&
        puedeValidarPagos
    ) { %>


        <div class="reservation-compact-decision-actions">


            <% if (
    Number(
        reservacion.antes_recogida
    ) === 1
) { %>

    <form
        action="/panel/reservaciones/<%= reservacion.id %>/confirmar"
        method="POST"
        onsubmit="return confirm('¿Aprobar la reservación <%= reservacion.codigo %>? Se aplicará la política de pago configurada para la agencia.');"
    >

        <button
            type="submit"
            class="reservation-compact-button reservation-compact-approve"
        >

            <i class="fa-solid fa-circle-check"></i>

            Aprobar reservación

        </button>

    </form>

<% } %>



            <form
                action="/panel/reservaciones/<%= reservacion.id %>/rechazar"
                method="POST"
                onsubmit="return confirm('¿Seguro que deseas rechazar la reservación <%= reservacion.codigo %>? Esta acción no podrá revertirse desde esta pantalla.');"
            >


                <button
                    type="submit"
                    class="reservation-compact-button reservation-compact-reject"
                >

                    <i class="fa-solid fa-circle-xmark"></i>

                    Rechazar reservación

                </button>


            </form>


        </div>



    <% } else if (
        reservacion.estado === "pendiente" &&
        !puedeValidarPagos
    ) { %>


        <div class="reservation-compact-message">


            <i class="fa-solid fa-clock"></i>


            <div>

                <strong>
                    Pendiente de decisión administrativa
                </strong>

                <span>

                    Un administrador de la agencia
                    debe aprobar o rechazar esta solicitud.

                </span>

            </div>


        </div>



    <% } else if (
        reservacion.estado === "pendiente_pago"
    ) { %>


        <div class="reservation-compact-message">


            <i class="fa-solid fa-credit-card"></i>


            <div>

                <strong>
                    Reservación aprobada
                </strong>

                <span>

                    Pendiente del anticipo de
                    US$<%= moneda(
                        resumenPago.montoAnticipoRequerido
                    ) %>.

                </span>

            </div>


        </div>



    <% } else { %>


        <div class="reservation-compact-message">


            <i class="fa-solid fa-circle-info"></i>


            <div>

                <strong>
                    Reservación procesada
                </strong>

                <span>

                    Estado actual:
                    <%= nombreEstadoReservacion %>.

                </span>

            </div>


        </div>


    <% } %>


</section>





