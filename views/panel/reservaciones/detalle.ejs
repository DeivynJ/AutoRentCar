                <span>

                    US$<%= moneda(
                        resumenPago.total
                    ) %>

                </span>

            </div>



            <div>

                <strong>
                    Anticipo requerido
                </strong>

                <span>

                    US$<%= moneda(
                        resumenPago.montoAnticipoRequerido
                    ) %>

                </span>

            </div>



            <div>

                <strong>
                    Pagado confirmado
                </strong>

                <span>

                    US$<%= moneda(
                        totalPagadoConfirmado
                    ) %>

                </span>

            </div>



            <div>

                <strong>
                    Por validar
                </strong>

                <span>
                    <%= pagosPendientesValidacion.length %>
                </span>

            </div>


        </div>



        <% if (
            pagosPendientesValidacion.length > 0
        ) { %>


            <div class="reservation-payment-attention">


                <i class="fa-solid fa-triangle-exclamation"></i>


                <span>

                    Hay

                    <strong>
                        <%= pagosPendientesValidacion.length %>
                    </strong>

                    pago(s) esperando validación.

                </span>


            </div>


        <% } %>


    </article>


</section>





<!-- =====================================
     INFORMACIÓN DESPLEGABLE
====================================== -->

<section class="reservation-details-stack">


    <!-- =================================
         CLIENTE COMPLETO
    ================================== -->

    <details class="reservation-compact-details">


        <summary>


            <span>

                <i class="fa-solid fa-user"></i>

                Información completa del cliente

            </span>


            <i class="fa-solid fa-chevron-down"></i>


        </summary>



        <div class="reservation-compact-details-body">


            <div class="reservation-compact-data-grid">


                <div>

                    <strong>
                        Nombre
                    </strong>

                    <span>
                        <%= reservacion.cliente_nombre || "No registrado" %>
                    </span>

                </div>



                <div>

                    <strong>
                        Documento
                    </strong>

                    <span>
                        <%= reservacion.cliente_documento || "No registrado" %>
                    </span>

                </div>



                <div>

                    <strong>
                        Correo electrónico
                    </strong>

                    <span>
                        <%= reservacion.cliente_correo || "No registrado" %>
                    </span>

                </div>



                <div>

                    <strong>
                        Teléfono
                    </strong>

                    <span>
                        <%= reservacion.cliente_telefono || "No registrado" %>
                    </span>

                </div>



                <div>

                    <strong>
                        Edad
                    </strong>

                    <span>

                        <%= reservacion.cliente_edad
                            ? `${reservacion.cliente_edad} años`
                            : "No registrada"
                        %>

                    </span>

                </div>



                <div>

                    <strong>
                        Licencia
                    </strong>

                    <span>
                        <%= reservacion.cliente_licencia || "No registrada" %>
                    </span>

                </div>


            </div>


        </div>


    </details>





    <!-- =================================
         ALQUILER
    ================================== -->

    <details class="reservation-compact-details">


        <summary>


            <span>

                <i class="fa-solid fa-car-side"></i>

                Detalles del alquiler

            </span>


            <i class="fa-solid fa-chevron-down"></i>


        </summary>



        <div class="reservation-compact-details-body">


            <div class="reservation-compact-data-grid">


                <div>

                    <strong>
                        Modelo
                    </strong>

                    <span>

                        <%= reservacion.modelo_marca %>
                        <%= reservacion.modelo_nombre %>

                    </span>

                </div>



                <div>

                    <strong>
                        Cantidad
                    </strong>

                    <span>
                        <%= reservacion.cantidad_vehiculos %>
                    </span>

                </div>



                <div>

                    <strong>
                        Precio diario
                    </strong>

                    <span>

                        US$<%= moneda(
                            resumenPago.precioDiario
                        ) %>

                    </span>

                </div>



                <div>

                    <strong>
                        Fecha de recogida
                    </strong>

                    <span>

                        <%= fechaSegura(
                            reservacion.fecha_recogida
                        ) %>

                        ·

                        <%= horaSegura(
                            reservacion.hora_recogida
                            
                            ) %>

                    </span>

                </div>



                <div>

                    <strong>
                        Lugar de recogida
                    </strong>

                    <span>
                        <%= reservacion.lugar_recogida || "No registrado" %>
                    </span>

                </div>



                <div>

                    <strong>
                        Fecha de devolución
                    </strong>

                    <span>

                        <%= fechaSegura(
                            reservacion.fecha_entrega
                        ) %>

                        ·

                        <%= horaSegura(
                            reservacion.hora_entrega
                            
                            ) %>

                    </span>

                </div>



                <div>

                    <strong>
                        Lugar de devolución
                    </strong>

                    <span>
                        <%= reservacion.lugar_entrega || "No registrado" %>
                    </span>

                </div>


            </div>


        </div>


    </details>


    <!-- =================================
         UNIDADES FÍSICAS
    ================================== -->

    <details class="reservation-compact-details">


        <summary>


            <span>

                <i class="fa-solid fa-car-rear"></i>

                Unidades físicas

            </span>


            <small>

                <%= unidadesReservacion.cantidadAsignada %>/<%= unidadesReservacion.cantidadSolicitada %>
                asignadas

            </small>


            <i class="fa-solid fa-chevron-down"></i>


        </summary>



        <div class="reservation-compact-details-body">


            <div class="reservation-compact-data-grid">


                <div>

                    <strong>
                        Solicitadas
                    </strong>

                    <span>
                        <%= unidadesReservacion.cantidadSolicitada %>
                    </span>

                </div>


                <div>

                    <strong>
                        Asignadas
                    </strong>

                    <span>
                        <%= unidadesReservacion.cantidadAsignada %>
                    </span>

                </div>


                <div>

                    <strong>
                        Pendientes
                    </strong>

                    <span>
                        <%= unidadesReservacion.cantidadPendiente %>
                    </span>

                </div>


            </div>



            <% if (
                unidadesReservacion.unidadesAsignadas.length
            ) { %>


                <div class="reservation-compact-services">


                    <% unidadesReservacion.unidadesAsignadas.forEach(
                        (unidad) => {
                    %>


                        <div class="reservation-compact-service-row">


                            <div>

                                <strong>
                                    <%= unidad.codigo_interno %>
                                </strong>

                                <span>

                                    <%= unidad.placa || "Sin placa" %>

                                    ·

                                    <%= unidad.sucursal_nombre || "Sin sucursal" %>

                                </span>

                            </div>


                            <strong>
                                Asignada
                            </strong>


                        </div>


                    <% }); %>


                </div>


            <% } else { %>


                <p class="reservation-compact-empty">

                    Esta reservación todavía no tiene
                    unidades físicas asignadas.

                </p>


            <% } %>



            <% if (
    unidadesReservacion.puedeAsignar &&
    Number(
        reservacion.antes_recogida
    ) === 1
) { %>


                <p class="reservation-compact-comment">

                    Unidades disponibles para asignar
                    en este período:

                </p>



                <% if (
    unidadesReservacion.unidadesCandidatas.length
) { %>


    <div class="reservation-compact-services">


        <% unidadesReservacion.unidadesCandidatas.forEach(
            (unidad) => {
        %>


            <div class="reservation-compact-service-row">


                <div>

                    <strong>
                        <%= unidad.codigo_interno %>
                    </strong>

                    <span>

                        <%= unidad.placa || "Sin placa" %>

                        ·

                        <%= unidad.sucursal_nombre || "Sin sucursal" %>

                    </span>

                </div>


                <% if (puedeGestionarUnidades) { %>


                    <form
                        method="POST"
                        action="/panel/reservaciones/<%= reservacion.id %>/unidades/asignar"
                    >

                        <input
                            type="hidden"
                            name="vehiculoId"
                            value="<%= unidad.id %>"
                        >


                        <button
                            type="submit"
                            class="reservation-compact-button reservation-compact-approve"
                        >

                            <i class="fa-solid fa-car-side"></i>

                            Asignar

                        </button>

                    </form>


                <% } else { %>


                    <strong>
                        Disponible
                    </strong>


                <% } %>


            </div>


        <% }); %>


    </div>


                <% } else { %>


                    <p class="reservation-compact-empty">

                        No hay unidades compatibles
                        disponibles para este período.

                    </p>


                <% } %>


            <% } else if (
                reservacion.estado === "confirmada"
            ) { %>


                <p class="reservation-compact-empty">

                    La cantidad solicitada ya está
                    completamente asignada.

                </p>


            <% } else { %>


                <p class="reservation-compact-empty">

                    Las unidades físicas podrán asignarse
                    cuando la reservación esté confirmada.

                </p>


            <% } %>


                </div>


    </details>


    <% if (puedeEntregarVehiculo) { %>


        <div class="reservation-compact-action">


            <form
                method="POST"
                action="/panel/reservaciones/<%= reservacion.id %>/entregar"
                onsubmit="return confirm('¿Confirmas que el vehículo fue entregado al cliente? La reservación pasará a alquiler en curso.');"
            >


                <button
                    type="submit"
                    class="reservation-compact-button reservation-compact-approve"
                >

                    <i class="fa-solid fa-car-side"></i>

                    Entregar vehículo

                </button>


            </form>


        </div>


    <% } %>

    <% if (puedeRegistrarDevolucion) { %>


    <div class="reservation-compact-action">


        <form
            method="POST"
            action="/panel/reservaciones/<%= reservacion.id %>/devolver"
            onsubmit="return confirm('¿Confirmas que el cliente devolvió el vehículo? La reservación será finalizada y la unidad volverá a estar disponible.');"
        >


            <button
                type="submit"
                class="reservation-compact-button reservation-compact-approve"
            >

                <i class="fa-solid fa-arrow-rotate-left"></i>

                Registrar devolución

            </button>


        </form>


    </div>


<% } %>


    <!-- =================================
         SERVICIOS ADICIONALES
    ================================== -->

    <details class="reservation-compact-details">


        <summary>


            <span>

                <i class="fa-solid fa-puzzle-piece"></i>

                Servicios adicionales

            </span>


            <small>
                <%= adicionales.length %>
            </small>


            <i class="fa-solid fa-chevron-down"></i>


        </summary>



        <div class="reservation-compact-details-body">


            <% if (adicionales.length) { %>


                <div class="reservation-compact-services">


                    <% adicionales.forEach((adicional) => { %>


                        <div class="reservation-compact-service-row">


                            <div>

                                <strong>
                                    <%= adicional.nombre %>
                                </strong>


                                <span>

                                    US$<%= moneda(
                                        adicional.precio_diario
                                    ) %>
                                    / día

                                    ·

                                    <%= adicional.cantidad_vehiculos %>
                                    vehículo(s)

                                    ·

                                    <%= adicional.dias %>
                                    día(s)

                                </span>

                            </div>


                            <strong>

                                US$<%= moneda(
                                    adicional.costo_total
                                ) %>

                            </strong>


                        </div>


                    <% }); %>


                </div>


            <% } else { %>


                <p class="reservation-compact-empty">

                    Esta reservación no incluye
                    servicios adicionales.

                </p>


            <% } %>


        </div>


    </details>





    <!-- =================================
         PAGOS
    ================================== -->

    <details
        class="reservation-compact-details"
        <%= pagosPendientesValidacion.length > 0
            ? "open"
            : ""
        %>
    >


        <summary>


            <span>

                <i class="fa-solid fa-money-check-dollar"></i>

                Pagos de la reservación

            </span>


            <small>
                <%= pagosSeguros.length %>
            </small>


            <i class="fa-solid fa-chevron-down"></i>


        </summary>



        <div class="reservation-compact-details-body">


            <% if (pagosSeguros.length) { %>


                <div class="reservation-compact-payments">


                    <% pagosSeguros.forEach((pago) => { %>


                        <%

                            let nombreEstadoPago =
                                pago.estado;


                            let claseEstadoPago =
                                "unit-status-reservado";


                            let nombreOrigenPago =
                                pago.origen;


                            if (
                                pago.estado ===
                                "pendiente_validacion"
                            ) {

                                nombreEstadoPago =
                                    "Pendiente de validación";

                            }


                            if (
                                pago.estado ===
                                "confirmado"
                            ) {

                                nombreEstadoPago =
                                    "Confirmado";

                                claseEstadoPago =
                                    "unit-status-disponible";

                            }


                            if (
                                pago.estado ===
                                "rechazado"
                            ) {

                                nombreEstadoPago =
                                    "Rechazado";

                                claseEstadoPago =
                                    "unit-status-inactivo";

                            }


                            if (
                                pago.estado ===
                                "anulado"
                            ) {

                                nombreEstadoPago =
                                    "Anulado";

                                claseEstadoPago =
                                    "unit-status-inactivo";

                            }


                            if (
                                pago.origen ===
                                "cliente"
                            ) {

                                nombreOrigenPago =
                                    "Cliente";

                            }


                            if (
                                pago.origen ===
                                "panel"
                            ) {

                                nombreOrigenPago =
                                    "Panel";

                            }


                            if (
                                pago.origen ===
                                "pasarela"
                            ) {

                                nombreOrigenPago =
                                    "Pasarela";

                            }

                        %>



                        <article class="reservation-compact-payment-row">


                            <div class="reservation-compact-payment-main">


                                <div>


                                    <strong>
                                        <%= pago.metodo_nombre %>
                                    </strong>


                                    <span>

                                        <%= pago.moneda %>$<%= moneda(
                                            pago.monto
                                        ) %>

                                        ·

                                        <%= fechaSegura(
                                            pago.fecha_pago
                                        ) %>

                                    </span>


                                </div>


                                <span
                                    class="unit-status <%= claseEstadoPago %>"
                                >

                                    <%= nombreEstadoPago %>

                                </span>


                            </div>



                            <div class="reservation-compact-payment-meta">


                                <div>

                                    <strong>
                                        Referencia
                                    </strong>

                                    <span>
                                        <%= pago.referencia || "No registrada" %>
                                    </span>

                                </div>


                                <div>

                                    <strong>
                                        Origen
                                    </strong>

                                    <span>
                                        <%= nombreOrigenPago %>
                                    </span>

                                </div>


                                <div>

                                    <strong>
                                        Tipo
                                    </strong>

                                    <span>
                                        <%= pago.metodo_tipo || "No especificado" %>
                                    </span>

                                </div>


                            </div>



                            <% if (
                                pago.comprobante_ruta
                            ) { %>


                                <div class="reservation-compact-proof">


                                    <div>

                                        <i class="fa-solid fa-file-invoice"></i>


                                        <span>

                                            <%= pago.comprobante_nombre_original
                                                || "Comprobante registrado"
                                            %>

                                        </span>

                                    </div>



                                    <% if (
                                        puedeValidarPagos
                                    ) { %>


                                        <a
                                            href="/panel/pagos/<%= pago.id %>/comprobante"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                            class="panel-secondary-button"
                                        >

                                            <i class="fa-solid fa-eye"></i>

                                            Ver comprobante

                                        </a>


                                    <% } %>


                                </div>


                            <% } %>

<% if (
    pago.estado === "pendiente_validacion" &&
    puedeValidarPagos
) { %>


    <div class="reservation-compact-payment-actions">


        <% if (
            Number(
                reservacion.antes_recogida
            ) === 1
        ) { %>


            <form
                action="/panel/pagos/<%= pago.id %>/confirmar"
                method="POST"
            >


                <button
                    type="submit"
                    class="reservation-compact-button reservation-compact-approve"
                    onclick="return confirm('¿Confirmar este pago de <%= pago.moneda %>$<%= moneda(pago.monto) %>? Esta acción registrará el pago como validado.');"
                >

                    <i class="fa-solid fa-circle-check"></i>

                    Confirmar pago

                </button>


            </form>


        <% } %>


        <details class="reservation-payment-reject-details">


            <summary>

                <i class="fa-solid fa-circle-xmark"></i>

                Rechazar pago

            </summary>


            <form
                action="/panel/pagos/<%= pago.id %>/rechazar"
                method="POST"
            >


                <label>

                    Motivo del rechazo

                    <textarea
                        name="motivo"
                        required
                        minlength="3"
                        maxlength="500"
                        rows="2"
                        placeholder="Escribe el motivo del rechazo"
                    ></textarea>

                </label>


                <button
                    type="submit"
                    class="reservation-compact-button reservation-compact-reject"
                    onclick="return confirm('¿Seguro que deseas rechazar este comprobante de pago?');"
                >

                    Confirmar rechazo

                </button>


            </form>


        </details>


    </div>


                            <% } else if (
                                pago.estado === "pendiente_validacion" &&
                                !puedeValidarPagos
                            ) { %>


                                <div class="reservation-compact-payment-note">


                                    <i class="fa-solid fa-clock"></i>


                                    <span>

                                        Pendiente de revisión por
                                        un administrador de la agencia.

                                    </span>


                                </div>


                            <% } else if (
                                pago.estado === "rechazado" &&
                                pago.motivo_rechazo
                            ) { %>


                                <div class="reservation-compact-payment-note rejected">


                                    <i class="fa-solid fa-circle-xmark"></i>


                                    <span>
                                        <%= pago.motivo_rechazo %>
                                    </span>


                                </div>


                            <% } %>


                        </article>


                    <% }); %>


                </div>


            <% } else { %>


                <p class="reservation-compact-empty">

                    Esta reservación todavía
                    no tiene pagos registrados.

                </p>


            <% } %>


        </div>


    </details>


    <!-- =================================
         FACTURACIÓN
    ================================== -->

    <details class="reservation-compact-details">


        <summary>


            <span>

                <i class="fa-solid fa-receipt"></i>

                Desglose de facturación

            </span>


            <strong>

                US$<%= moneda(
                    resumenPago.total
                ) %>

            </strong>


            <i class="fa-solid fa-chevron-down"></i>


        </summary>



        <div class="reservation-compact-details-body">


            <div class="reservation-compact-billing">


                <div>

                    <span>
                        Subtotal
                    </span>

                    <strong>

                        US$<%= moneda(
                            resumenPago.subtotal
                        ) %>

                    </strong>

                </div>



                <div>

                    <span>
                        Servicios adicionales
                    </span>

                    <strong>

                        US$<%= moneda(
                            resumenPago.adicionales
                        ) %>

                    </strong>

                </div>



                <div>

                    <span>
                        Descuento
                    </span>

                    <strong>

                        - US$<%= moneda(
                            resumenPago.descuento
                        ) %>

                    </strong>

                </div>



                <div>

                    <span>
                        Código promocional
                    </span>

                    <strong>

                        <%= reservacion.codigo_promocional
                            || "No aplicado"
                        %>

                    </strong>

                </div>



                <div class="reservation-compact-billing-total">

                    <span>
                        Total
                    </span>

                    <strong>

                        US$<%= moneda(
                            resumenPago.total
                        ) %>

                    </strong>

                </div>


            </div>


        </div>


    </details>





    <!-- =================================
         COMENTARIOS
    ================================== -->

    <details class="reservation-compact-details">


        <summary>


            <span>

                <i class="fa-regular fa-comment-dots"></i>

                Comentarios del cliente

            </span>


            <i class="fa-solid fa-chevron-down"></i>


        </summary>



        <div class="reservation-compact-details-body">


            <p class="reservation-compact-comment">

                <%= reservacion.comentarios
                    || "El cliente no agregó comentarios a esta reservación."
                %>

            </p>


        </div>


    </details>


</section>


        

            </main>

        </div>

    </div>


    <script src="/js/panel.js"></script>

</body>

</html>