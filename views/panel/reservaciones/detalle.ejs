        <span class="reservation-detail-summary-main">

            <span class="reservation-detail-summary-icon">

                <i class="fa-solid fa-calendar-days"></i>

            </span>


            <span class="reservation-detail-summary-copy">

                <strong>
                    Detalles del alquiler
                </strong>

                <small>
