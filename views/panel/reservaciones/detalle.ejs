        <i class="fa-solid fa-triangle-exclamation"></i>

        <span>
            Esta reservación no está disponible para realizar la entrega.
        </span>

    </div>

<% } %>

<% if (String(queryError || "") === "entrega_anticipada") { %>

    <div class="panel-reservation-message warning">

        <i class="fa-solid fa-clock"></i>

