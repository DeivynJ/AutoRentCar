        <i class="fa-solid fa-circle-check"></i>

        <span>

            La reservación fue aprobada correctamente.
            Ahora está pendiente del pago del anticipo.

        </span>

    </div>

<% } %>

<% if (String(queryResultado || "") === "rechazada") { %>

    <div class="panel-reservation-message danger">

        <i class="fa-solid fa-circle-xmark"></i>

        <span>
            La reservación fue rechazada correctamente.
