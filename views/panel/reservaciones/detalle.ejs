                <div class="reservation-rental-point-header">


                    <span class="reservation-rental-point-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </span>


                    <div>

                        <small>
                            Inicio del alquiler
                        </small>

                        <strong>
