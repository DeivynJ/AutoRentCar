                <%

    const pagosSeguros =
        Array.isArray(pagos)
            ? pagos
            : [];


    const pagosPendientesValidacion =
        pagosSeguros.filter(
            (pago) =>
                pago.estado ===
                "pendiente_validacion"
        );


    const pagosConfirmados =
        pagosSeguros.filter(
            (pago) =>
                pago.estado ===
                "confirmado"
        );


    const totalPagadoConfirmado =
        pagosConfirmados.reduce(
            (total, pago) =>
                total +
                Number(
                    pago.monto ||
                    0
                ),
            0
        );

%>

