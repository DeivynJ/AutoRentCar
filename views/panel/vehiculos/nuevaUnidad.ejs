<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >


    <title>
        <%= titulo %> | <%= agencia.nombre %>
    </title>


    <%- include("../partials/tema") %>


    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >


    <link
        rel="stylesheet"
        href="/css/panel.css"
    >

</head>


<body>

<div class="panel-shell">


    <%- include("../partials/sidebar") %>


    <div class="panel-content-wrapper">


        <%- include("../partials/header") %>


        <main class="panel-main">


            <div class="panel-form-back">

                <a
                    href="/panel/vehiculos/modelos/<%= modelo.id %>/unidades"
                >

                    <i class="fa-solid fa-arrow-left"></i>

                    Volver a las unidades

                </a>

            </div>


            <section class="panel-module-hero panel-form-hero">

                <div>

                    <span class="panel-module-badge">

                        <i class="fa-solid fa-plus"></i>

                        Nueva unidad

                    </span>


                    <h2>

                        <%= modelo.marca %>

                        <span>
                            <%= modelo.nombre %>
                        </span>

                    </h2>


                    <p>

                        Registra un vehículo físico perteneciente
                        a este modelo dentro de la flota de
                        <strong><%= agencia.nombre %></strong>.

                    </p>

                </div>


                <div class="panel-form-hero-icon">

                    <i class="fa-solid fa-car"></i>

                </div>

            </section>


            <% if (error) { %>

                <div class="panel-alert panel-alert-danger">

                    <i class="fa-solid fa-circle-exclamation"></i>

                    <div>

                        <strong>
                            No fue posible registrar la unidad
                        </strong>

                        <span>
                            <%= error %>
                        </span>

                    </div>

                </div>

            <% } %>


            <% if (!sucursales.length) { %>

                <div class="panel-alert panel-alert-danger">

                    <i class="fa-solid fa-location-dot"></i>

                    <div>

                        <strong>
                            No hay sucursales activas
                        </strong>

                        <span>
                            Debes tener al menos una sucursal activa
                            antes de registrar una unidad física.
                        </span>

                    </div>

                </div>

            <% } %>


            <!-- USO DEL PLAN -->

            <section class="panel-fleet-plan panel-fleet-plan-form">

                <div>

                    <i class="fa-solid fa-layer-group"></i>

                    <div>

                        <small>
                            Vehículos activos
                        </small>

                        <strong>

                            <%= vehiculosActivos %>

                            /

                            <%= plan.limiteVehiculos === null
                                ? "Ilimitado"
                                : plan.limiteVehiculos
                            %>

                        </strong>

                    </div>

                </div>


                <div>

                    <small>
                        Plan actual
                    </small>

                    <strong>
                        <%= plan.nombre %>
                    </strong>

                </div>

            </section>


            <form
                action="/panel/vehiculos/modelos/<%= modelo.id %>/unidades/nueva"
                method="POST"
                class="panel-model-form"
            >


                <section class="panel-form-card">


                    <div class="panel-form-card-header">

                        <span class="panel-form-card-icon">

                            <i class="fa-solid fa-id-card"></i>

                        </span>


                        <div>

                            <span>
                                Identificación
                            </span>

                            <h3>
                                Datos de la unidad
                            </h3>

                            <p>
                                Información que identifica
                                específicamente este vehículo.
                            </p>

                        </div>

                    </div>


                    <div class="panel-form-grid">


                        <div class="panel-form-field">

                            <label for="codigo_interno">
                                Código interno *
                            </label>

                            <input
                                type="text"
                                id="codigo_interno"
                                name="codigo_interno"
                                maxlength="50"
                                value="<%= datos.codigo_interno %>"
                                placeholder="Ej.: COR-001"
                                required
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="placa">
                                Placa
                            </label>

                            <input
                                type="text"
                                id="placa"
                                name="placa"
                                maxlength="30"
                                value="<%= datos.placa %>"
                                placeholder="Ej.: AA12345"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="vin">
                                VIN
                            </label>

                            <input
                                type="text"
                                id="vin"
                                name="vin"
                                maxlength="50"
                                value="<%= datos.vin %>"
                                placeholder="Número de identificación"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="color">
                                Color
                            </label>

                            <input
                                type="text"
                                id="color"
                                name="color"
                                maxlength="50"
                                value="<%= datos.color %>"
                                placeholder="Ej.: Blanco"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="kilometraje">
                                Kilometraje
                            </label>

                            <input
                                type="number"
                                id="kilometraje"
                                name="kilometraje"
                                min="0"
                                step="1"
                                value="<%= datos.kilometraje %>"
                                required
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="sucursal_id">
                                Sucursal *
                            </label>

                            <select
                                id="sucursal_id"
                                name="sucursal_id"
                                required
                                <%= !sucursales.length ? "disabled" : "" %>
                            >

                                <% if (!sucursales.length) { %>

                                    <option value="">
                                        No hay sucursales activas
                                    </option>

                                <% } %>


                                <% sucursales.forEach((sucursal) => { %>

                                    <option
                                        value="<%= sucursal.id %>"
                                        <%= String(datos.sucursal_id) === String(sucursal.id) ? "selected" : "" %>
                                    >

                                        <%= sucursal.nombre %>

                                        <%= Number(sucursal.es_principal) === 1
                                            ? " — Principal"
                                            : ""
                                        %>

                                    </option>

                                <% }); %>

                            </select>

                        </div>


                        <div class="panel-form-field panel-form-full">

                            <label for="estado">
                                Estado inicial *
                            </label>

                            <select
                                id="estado"
                                name="estado"
                                required
                            >

                                <option
                                    value="disponible"
                                    <%= datos.estado === "disponible" ? "selected" : "" %>
                                >
                                    Disponible
                                </option>

                                <option
                                    value="reservado"
                                    <%= datos.estado === "reservado" ? "selected" : "" %>
                                >
                                    Reservado
                                </option>

                                <option
                                    value="alquilado"
                                    <%= datos.estado === "alquilado" ? "selected" : "" %>
                                >
                                    Alquilado
                                </option>

                                <option
                                    value="mantenimiento"
                                    <%= datos.estado === "mantenimiento" ? "selected" : "" %>
                                >
                                    Mantenimiento
                                </option>

                                <option
                                    value="inactivo"
                                    <%= datos.estado === "inactivo" ? "selected" : "" %>
                                >
                                    Inactivo
                                </option>

                            </select>

                        </div>

                    </div>

                </section>


                <div class="panel-form-note">

                    <i class="fa-solid fa-circle-info"></i>

                    <div>

                        <strong>
                            Esta sí cuenta como vehículo del plan
                        </strong>

                        <p>

                            Una unidad con estado Disponible,
                            Reservado, Alquilado o Mantenimiento
                            consume un espacio del límite de
                            vehículos contratado por la agencia.
                            Las unidades Inactivas no consumen cupo.

                        </p>

                    </div>

                </div>


                <div class="panel-form-actions">


                    <a
                        href="/panel/vehiculos/modelos/<%= modelo.id %>/unidades"
                        class="panel-form-cancel"
                    >
                        Cancelar
                    </a>


                    <button
                        type="submit"
                        class="panel-form-submit"
                        <%= !sucursales.length ? "disabled" : "" %>
                    >

                        <i class="fa-solid fa-floppy-disk"></i>

                        Registrar unidad

                    </button>

                </div>


            </form>


            <footer class="panel-footer">

                <span>
                    <%= agencia.nombre %>
                </span>

                <span>
                    AutoRentCar Platform ·
                    © <%= new Date().getFullYear() %>
                </span>

            </footer>


        </main>

    </div>

</div>


<script src="/js/panel.js"></script>


</body>

</html>