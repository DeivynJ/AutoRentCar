<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Registrar una nueva sucursal para <%= agencia.nombre %>."
    >

    <title>
        <%= titulo %> | <%= agencia.nombre %>
    </title>


    <%- include("../partials/tema") %>


    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    >

    <link
        rel="stylesheet"
        href="/css/panel.css"
    >

</head>


<body>


<div class="panel-shell">


    <%- include("../partials/sidebar") %>


    <div class="panel-content-wrapper">


        <%- include("../partials/header") %>


        <main class="panel-main">


            <!-- =====================================
                 VOLVER
            ====================================== -->

            <div class="panel-form-back">

                <a href="/panel/sucursales">

                    <i class="fa-solid fa-arrow-left"></i>

                    Volver a sucursales

                </a>

            </div>


            <!-- =====================================
                 ENCABEZADO
            ====================================== -->

            <section class="panel-module-hero panel-form-hero">


                <div>

                    <span class="panel-module-badge">

                        <i class="fa-solid fa-plus"></i>

                        Nueva sucursal

                    </span>


                    <h2>

                        Registrar ubicación para

                        <span>
                            <%= agencia.nombre %>
                        </span>

                    </h2>


                    <p>

                        Agrega una nueva ubicación operativa
                        perteneciente exclusivamente a tu agencia.

                    </p>

                </div>


                <div class="panel-form-hero-icon">

                    <i class="fa-solid fa-building-circle-check"></i>

                </div>


            </section>


            <!-- =====================================
                 ERROR
            ====================================== -->

            <% if (error) { %>

                <div class="panel-alert panel-alert-danger">

                    <i class="fa-solid fa-circle-exclamation"></i>


                    <div>

                        <strong>
                            No fue posible registrar la sucursal
                        </strong>

                        <span>
                            <%= error %>
                        </span>

                    </div>

                </div>

            <% } %>


            <!-- =====================================
                 LÍMITE ALCANZADO
            ====================================== -->

            <% if (limiteAlcanzado) { %>

                <div class="panel-alert panel-alert-danger">

                    <i class="fa-solid fa-layer-group"></i>


                    <div>

                        <strong>
                            Límite de sucursales activas alcanzado
                        </strong>

                        <span>

                            Tu plan permite

                            <%= limiteSucursales %>

                            <%= limiteSucursales === 1
                                ? "sucursal activa"
                                : "sucursales activas" %>.

                            Puedes registrar esta ubicación como
                            inactiva, pero no podrá activarse hasta
                            que exista un cupo disponible.

                        </span>

                    </div>

                </div>

            <% } %>


            <!-- =====================================
                 USO DEL PLAN
            ====================================== -->

            <section class="panel-fleet-plan panel-fleet-plan-form">


                <div>

                    <i class="fa-solid fa-location-dot"></i>


                    <div>

                        <small>
                            Sucursales activas
                        </small>


                        <strong>

                            <%= sucursalesActivas %>

                            /

                            <%= limiteSucursales === null
                                ? "Ilimitado"
                                : limiteSucursales %>

                        </strong>

                    </div>

                </div>


                <div>

                    <small>
                        Plan actual
                    </small>

                    <strong>
                        <%= plan.nombre %>
                    </strong>

                </div>


            </section>


            <!-- =====================================
                 FORMULARIO
            ====================================== -->

            <form
                action="/panel/sucursales/nueva"
                method="POST"
                class="panel-model-form"
            >


                <!-- ==============================
                     INFORMACIÓN GENERAL
                =============================== -->

                <section class="panel-form-card">


                    <div class="panel-form-card-header">


                        <span class="panel-form-card-icon">

                            <i class="fa-solid fa-building"></i>

                        </span>


                        <div>

                            <span>
                                Información general
                            </span>

                            <h3>
                                Datos de la sucursal
                            </h3>

                            <p>

                                Identifica esta ubicación dentro
                                de la operación de tu RentCar.

                            </p>

                        </div>


                    </div>


                    <div class="panel-form-grid">


                        <div class="panel-form-field panel-form-full">

                            <label for="nombre">
                                Nombre de la sucursal *
                            </label>


                            <input
                                type="text"
                                id="nombre"
                                name="nombre"
                                maxlength="120"
                                value="<%= datos.nombre || '' %>"
                                placeholder="Ej.: Sucursal Aeropuerto Internacional del Cibao"
                                required
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="correo">
                                Correo electrónico
                            </label>


                            <input
                                type="email"
                                id="correo"
                                name="correo"
                                maxlength="150"
                                value="<%= datos.correo || '' %>"
                                placeholder="sucursal@ejemplo.com"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="telefono">
                                Teléfono
                            </label>


                            <input
                                type="text"
                                id="telefono"
                                name="telefono"
                                maxlength="30"
                                value="<%= datos.telefono || '' %>"
                                placeholder="809-000-0000"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="whatsapp">
                                WhatsApp
                            </label>


                            <input
                                type="text"
                                id="whatsapp"
                                name="whatsapp"
                                maxlength="30"
                                value="<%= datos.whatsapp || '' %>"
                                placeholder="809-000-0000"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="estado">
                                Estado inicial *
                            </label>


                            <select
                                id="estado"
                                name="estado"
                                required
                            >

                                <option
                                    value="activa"
                                    <%= datos.estado === "activa"
                                        ? "selected"
                                        : "" %>
                                    <%= !puedeCrearActiva
                                        ? "disabled"
                                        : "" %>
                                >
                                    Activa
                                </option>


                                <option
                                    value="inactiva"
                                    <%= datos.estado === "inactiva"
                                        ? "selected"
                                        : "" %>
                                >
                                    Inactiva
                                </option>

                            </select>


                            <% if (!puedeCrearActiva) { %>

                                <small class="panel-field-help">

                                    La suscripción no dispone de
                                    cupo para otra sucursal activa.

                                </small>

                            <% } %>

                        </div>


                    </div>


                </section>


                <!-- ==============================
                     UBICACIÓN
                =============================== -->

                <section class="panel-form-card">


                    <div class="panel-form-card-header">


                        <span class="panel-form-card-icon">

                            <i class="fa-solid fa-map-location-dot"></i>

                        </span>


                        <div>

                            <span>
                                Ubicación
                            </span>

                            <h3>
                                Dirección de la sucursal
                            </h3>

                            <p>

                                Estos datos podrán utilizarse
                                posteriormente en el sitio público
                                y en la operación interna.

                            </p>

                        </div>


                    </div>


                    <div class="panel-form-grid">


                        <div class="panel-form-field panel-form-full">

                            <label for="direccion">
                                Dirección
                            </label>


                            <input
                                type="text"
                                id="direccion"
                                name="direccion"
                                maxlength="255"
                                value="<%= datos.direccion || '' %>"
                                placeholder="Dirección física de la sucursal"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="ciudad">
                                Ciudad
                            </label>


                            <input
                                type="text"
                                id="ciudad"
                                name="ciudad"
                                maxlength="100"
                                value="<%= datos.ciudad || '' %>"
                                placeholder="Ej.: Santiago"
                            >

                        </div>


                        <div class="panel-form-field">

                            <label for="provincia">
                                Provincia
                            </label>


                            <input
                                type="text"
                                id="provincia"
                                name="provincia"
                                maxlength="100"
                                value="<%= datos.provincia || '' %>"
                                placeholder="Ej.: Santiago"
                            >

                        </div>


                        <div class="panel-form-field panel-form-full">

                            <label for="pais">
                                País *
                            </label>


                            <input
                                type="text"
                                id="pais"
                                name="pais"
                                maxlength="100"
                                value="<%= datos.pais || 'República Dominicana' %>"
                                required
                            >

                        </div>


                    </div>


                </section>


                <!-- ==============================
                     TIPO DE SUCURSAL
                =============================== -->

                <section class="panel-form-card">


                    <div class="panel-form-card-header">


                        <span class="panel-form-card-icon">

                            <i class="fa-solid fa-star"></i>

                        </span>


                        <div>

                            <span>
                                Organización
                            </span>

                            <h3>
                                Tipo de sucursal
                            </h3>

                            <p>

                                Define cuál ubicación representa
                                la sucursal principal de la agencia.

                            </p>

                        </div>


                    </div>


                    <% if (totalSucursales === 0) { %>


                        <div class="panel-form-note">

                            <i class="fa-solid fa-star"></i>


                            <div>

                                <strong>
                                    Primera sucursal
                                </strong>


                                <p>

                                    Al ser la primera sucursal de
                                    <%= agencia.nombre %>, se
                                    establecerá automáticamente como
                                    principal.

                                </p>

                            </div>

                        </div>


                    <% } else { %>


                        <div class="panel-form-grid">


                            <div class="panel-form-field panel-form-full">

                                <label for="es_principal">
                                    Tipo
                                </label>


                                <select
                                    id="es_principal"
                                    name="es_principal"
                                >

                                    <option
                                        value="0"
                                        <%= datos.es_principal !== "1"
                                            ? "selected"
                                            : "" %>
                                    >
                                        Sucursal secundaria
                                    </option>


                                    <option
                                        value="1"
                                        <%= datos.es_principal === "1"
                                            ? "selected"
                                            : "" %>
                                    >
                                        Sucursal principal
                                    </option>

                                </select>

                            </div>


                        </div>


                    <% } %>


                </section>


                <!-- =====================================
                     POLÍTICA DEL PLAN
                ====================================== -->

                <div class="panel-form-note">

                    <i class="fa-solid fa-circle-info"></i>


                    <div>

                        <strong>
                            Política de sucursales de tu plan
                        </strong>


                        <p>

                            Solamente las sucursales con estado
                            Activa consumen un espacio del límite
                            contratado. Las sucursales Inactivas
                            no consumen cupo. Activar posteriormente
                            una sucursal volverá a comprobar el
                            límite disponible de la suscripción.

                        </p>

                    </div>

                </div>


                <!-- =====================================
                     ACCIONES
                ====================================== -->

                <div class="panel-form-actions">


                    <a
                        href="/panel/sucursales"
                        class="panel-form-cancel"
                    >
                        Cancelar
                    </a>


                    <button
                        type="submit"
                        class="panel-form-submit"
                    >

                        <i class="fa-solid fa-floppy-disk"></i>

                        Registrar sucursal

                    </button>


                </div>


            </form>


            <footer class="panel-footer">

                <span>
                    <%= agencia.nombre %>
                </span>

                <span>
                    AVYNEXO Platform ·
                    © <%= new Date().getFullYear() %>
                </span>

            </footer>


        </main>


    </div>


</div>


<script src="/js/panel.js"></script>


</body>

</html>